/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://analytics.ahrefs.com https://pagead2.googlesyndication.com https://partner.googleadservices.com https://www.googletagservices.com; connect-src 'self' https://analytics.ahrefs.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://*.supabase.co https://*.supabase.com https://api.stripe.com https://r.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com https://tpc.googlesyndication.com https://googleads.g.doubleclick.net; worker-src 'self' blob:;

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logo-nav.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/facilities_index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/city_index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/facilities_index_shards/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/help-registry.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
