---
import Base from '../layouts/Base.astro';

type TocItem = {
  id: string;
  label: string;
};

type FaqItem = {
  question: string;
  answer: string;
};

type LinkItem = {
  href: string;
  label: string;
};

const {
  title,
  description,
  canonical,
  heroEyebrow = 'SilverTech Family Guide',
  h1,
  deck,
  published,
  modified,
  readTime = '12 min read',
  toc = [] as TocItem[],
  faqItems = [] as FaqItem[],
  relatedLinks = [] as LinkItem[],
  resourceLinks = [] as LinkItem[],
  keywordPills = [] as string[],
  ogImage = 'https://silvertechdirectory.com/hero.png'
} = Astro.props;

const authorName = 'SilverTech Editorial Team';
const topCityGeoLinks: LinkItem[] = [
  { href: '/memory-care/california/san-francisco/', label: 'Memory care in San Francisco, CA' },
  { href: '/assisted-living/florida/saint-petersburg/', label: 'Senior care in Saint Petersburg, FL' },
  { href: '/memory-care/florida/fort-myers/', label: 'Memory care in Fort Myers, FL' },
  { href: '/assisted-living/oklahoma/oklahoma-city/', label: 'Senior care in Oklahoma City, OK' },
  { href: '/assisted-living/alabama/birmingham/', label: 'Senior care in Birmingham, AL' },
  { href: '/assisted-living/michigan/grand-rapids/', label: 'Senior care in Grand Rapids, MI' },
  { href: '/assisted-living/arkansas/little-rock/', label: 'Senior care in Little Rock, AR' },
  { href: '/assisted-living/louisiana/baton-rouge/', label: 'Senior care in Baton Rouge, LA' }
];
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  twitterSite="@SilverTechCare"
  liteHead={true}
  publishedTime={published}
  modifiedTime={modified}
>
  <link slot="head" rel="stylesheet" href="/styles/guide-article.css" />

  <section class="container guide-shell">
    <h1 class="sr-only">{h1}</h1>
    <div class="crawl-priority-signals">
      <h2>Guide Evidence Signals</h2>
      <p>
        Editorial guide by {authorName}. Published <time datetime={published}>{published}</time>, updated
        <time datetime={modified}>{modified}</time>.
      </p>
      <ul class="signal-list">
        <li><strong>Read time:</strong> {readTime}</li>
        <li><strong>Topics indexed:</strong> {keywordPills.length || toc.length || 1}</li>
        <li><strong>FAQ coverage:</strong> {faqItems.length > 0 ? `${faqItems.length} answers` : 'Not included'}</li>
      </ul>
    </div>
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/guides/">Guides</a>
      <span>/</span>
      <span>{h1}</span>
    </nav>

    <div class="guide-hero">
      <picture class="hero-image">
        <source srcset="/hero.avif" type="image/avif" />
        <source srcset="/hero.webp" type="image/webp" />
        <img
          src="/hero.png"
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          alt={`${h1} guide`}
        />
      </picture>
      <div class="guide-hero-content">
        <p class="eyebrow">{heroEyebrow}</p>
        <p class="hero-title">{h1}</p>
        <p>{deck}</p>
        <div class="hero-meta">
          <span><strong>By:</strong> {authorName}</span>
          <span><strong>Published:</strong> <time datetime={published}>{published}</time></span>
          <span><strong>Updated:</strong> <time datetime={modified}>{modified}</time></span>
          <span><strong>Read:</strong> {readTime}</span>
        </div>
        <a class="btn-primary" href="/search">Browse care options</a>
      </div>
    </div>
  </section>

  <section class="container guide-layout">
    <article class="card guide-main">
      {toc.length > 0 && (
        <nav aria-label="Table of contents" class="toc">
          <p><strong>In this guide</strong></p>
          <ol>
            {toc.map((item) => (
              <li><a href={`#${item.id}`}>{item.label}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <slot />

      {faqItems.length > 0 && (
        <section id="faq" class="faq-block" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqItems.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {relatedLinks.length > 0 && (
        <section class="related-block" aria-label="Related guides">
          <h2>Related Guides</h2>
          <ul>
            {relatedLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <aside class="side-stack">
      {resourceLinks.length > 0 && (
        <section class="card side-card">
          <h2>Key Resources</h2>
          <ul class="simple-list">
            {resourceLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      )}

      <section class="card side-card">
        <h2>Top City Care Hubs</h2>
        <p class="side-note">
          Compare local options in major markets where families frequently begin memory care and assisted living searches.
        </p>
        <ul class="simple-list">
          {topCityGeoLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </section>

      {keywordPills.length > 0 && (
        <section class="card side-card">
          <h2>Topics Covered</h2>
          <ul class="pill-list">
            {keywordPills.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>
        </section>
      )}

      <section class="card side-card cta-card">
        <h2>Need Immediate Options?</h2>
        <p>Use SilverTech search to compare licensed communities without referral pressure.</p>
        <a class="btn-primary" href="/search">Start directory search</a>
      </section>
    </aside>
  </section>

  <slot name="head" />
</Base>
