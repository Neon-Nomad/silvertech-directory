---
import Base from '../../layouts/Base.astro';

const title = 'Senior Living Guides | SilverTech Directory';
const description = 'Evidence-based guides for dementia families covering emotional stress, care decisions, and real memory care costs.';
const canonical = 'https://silvertechdirectory.com/guides/';
const keywords = [
  'senior living guides',
  'dementia caregiver support',
  'memory care planning guides',
  'caregiver stress resources'
].join(', ');

const guides = [
  {
    href: '/guides/what-families-miss-state-regulations/',
    title: 'What Families Miss Without Reviewing State Regulations',
    summary: 'The regulation-first decision guide: staffing, inspections, disclosures, and state-by-state differences families miss on tours.',
    category: 'Regulation Guide',
  },
  {
    href: '/guides/assisted-living-vs-nursing-home-real-differences/',
    title: 'Assisted Living vs Nursing Home: The Real Differences',
    summary: 'A practical, regulation-aware comparison of care intensity, staffing, payer realities, and transition risk.',
    category: 'Comparison Guide',
  },
  {
    href: '/guides/senior-care-definitions-plain-english-regulations/',
    title: 'Senior Care Definitions: Plain-English Glossary',
    summary: 'Quotable plain-English definitions for care terms families confuse, tied to state regulation context.',
    category: 'Reference Guide',
  },
  {
    href: '/guides/how-to-choose/',
    title: 'How to Choose a Senior Living Community',
    summary: 'A step-by-step framework for evaluating care levels, staffing, licensing, and fit — without referral agency pressure.',
    category: 'Decision Guide',
  },
  {
    href: '/guides/what-it-costs/',
    title: 'What Senior Living Actually Costs',
    summary: 'Base rates, care tiers, add-ons, and how to compare communities fairly. What the quoted rate never tells you.',
    category: 'Financial Guide',
  },
  {
    href: '/guides/tour-questions/',
    title: 'Questions to Ask on a Senior Living Tour',
    summary: '20+ questions for tours — focused on staffing, safety, costs, and care transitions. Not the tour script.',
    category: 'Tour Guide',
  },
  {
    href: '/guides/hidden-costs-of-memory-care/',
    title: 'Hidden Costs of Memory Care: What Families Are Never Told Up Front',
    summary: 'Care levels, medication fees, supply charges, and contract terms that drive the real monthly bill.',
    category: 'Financial Guide',
  },
  {
    href: '/guides/guilt-about-placing-parent-in-memory-care/',
    title: 'Guilt About Placing a Parent in Memory Care',
    summary: 'How to separate guilt from grief and make safer decisions without abandoning love.',
    category: 'Emotional Support',
  },
  {
    href: '/guides/grief-while-parent-is-still-alive-dementia/',
    title: 'Grief While Parent Is Still Alive With Dementia',
    summary: 'A practical guide to ambiguous loss and emotional stabilization for caregivers.',
    category: 'Emotional Support',
  },
  {
    href: '/guides/caregiver-resentment-toward-parent/',
    title: 'Caregiver Resentment Toward Parent',
    summary: 'Why resentment appears, how to reduce overload, and when to reset the care model.',
    category: 'Emotional Support',
  },
  {
    href: '/guides/sibling-not-helping-parent-care/',
    title: 'Sibling Not Helping With Parent Care',
    summary: 'Scripts, workload models, and decision frameworks when family support is uneven.',
    category: 'Emotional Support',
  },
  {
    href: '/guides/caregiver-at-breaking-point/',
    title: 'I Cannot Do This Anymore Caring for My Parent',
    summary: 'High-urgency steps for caregiver crisis stabilization and emergency care planning.',
    category: 'Emotional Support',
  },
];

const featuredCostGuides = [
  { href: '/guides/costs/assisted-living/california/', state: 'California', care: 'Assisted Living', cost: '$5,739/mo' },
  { href: '/guides/costs/assisted-living/texas/',      state: 'Texas',      care: 'Assisted Living', cost: '$4,459/mo' },
  { href: '/guides/costs/assisted-living/florida/',    state: 'Florida',    care: 'Assisted Living', cost: '$4,624/mo' },
  { href: '/guides/costs/memory-care/new-york/',       state: 'New York',   care: 'Memory Care',     cost: '$7,765/mo' },
  { href: '/guides/costs/memory-care/texas/',          state: 'Texas',      care: 'Memory Care',     cost: '$5,684/mo' },
  { href: '/guides/costs/assisted-living/new-jersey/', state: 'New Jersey', care: 'Assisted Living', cost: '$7,480/mo' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://silvertechdirectory.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: canonical }
  ]
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: guides.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://silvertechdirectory.com${guide.href}`,
    name: guide.title
  }))
};
---

<Base title={title} description={description} canonical={canonical}>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  <link slot="head" rel="stylesheet" href="/styles/senior-living.css" />

  <div class="container sl-page sl-state-page">
    <nav class="sl-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span>Guides</span>
    </nav>

    <section class="sl-state-hero">
      <div class="sl-state-hero-copy">
        <div class="sl-state-hero-badge-row">
          <span class="sl-state-hero-flag" aria-hidden="true">US</span>
          <span class="sl-state-hero-kicker">SilverTech Editorial Hub</span>
        </div>
        <h1 class="sl-state-hero-title">
          <span>Family </span>
          <span class="sl-state-hero-accent">Care Guides</span>
        </h1>
        <p class="sl-state-hero-lead">
          Practical and emotional support for families navigating dementia care and senior living decisions. Every guide is written for clarity under stress, providing direct paths to compare licensed communities without referral agency pressure.
        </p>
        <div class="sl-state-hero-actions">
          <a class="sl-btn sl-btn-primary" href="#guides-index">Browse All Guides</a>
          <a class="sl-btn sl-btn-secondary" href="/search">Search Communities</a>
        </div>
      </div>
    </section>

    <section class="sl-state-stats" aria-label="Editorial stats">
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">{guides.length + 97}</p>
        <p class="sl-state-stat-label">Published Guides</p>
        <p class="sl-state-stat-note">Evidence-based resources</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">Real</p>
        <p class="sl-state-stat-label">Advice</p>
        <p class="sl-state-stat-note">Practical family support</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">Direct</p>
        <p class="sl-state-stat-label">Search</p>
        <p class="sl-state-stat-note">Commission-free model</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">51</p>
        <p class="sl-state-stat-label">States</p>
        <p class="sl-state-stat-note">National market access</p>
      </article>
    </section>

    <section class="sl-state-section" id="guides-index">
      <div class="sl-state-section-head">
        <div>
          <p class="sl-state-section-kicker">Featured Resources</p>
          <h2>Senior Living Decision Guides</h2>
          <p>Dementia care planning, emotional stress management, and financial transparency tools for families.</p>
        </div>
      </div>

      <div class="sl-state-method-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
        {guides.map((guide) => (
          <article class="sl-state-method-card">
            <h3><a href={guide.href} style="color: inherit; text-decoration: none;">{guide.title}</a></h3>
            <p>{guide.summary}</p>
            <div style="margin-top: 1.5rem;">
              <a href={guide.href} class="sl-city-section-link">Read Full Guide</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

    <section class="sl-state-section">
      <div class="sl-state-section-head">
        <div>
          <p class="sl-state-section-kicker">State Cost Guides</p>
          <h2>What does senior care cost in your state?</h2>
          <p>State-specific cost guides built from 2025 move-in data. Each guide shows the state median, vs-national comparison, top cities, and Medicaid context.</p>
        </div>
        <a class="sl-state-section-link" href="/assisted-living/">Browse all states</a>
      </div>
      <div class="sl-state-market-grid">
        {featuredCostGuides.map((g) => (
          <a class="sl-state-market-link" href={g.href}>
            <strong>{g.state} — {g.care}</strong>
            <span>State median {g.cost}</span>
          </a>
        ))}
        <a class="sl-state-market-link" href="/guides/costs/assisted-living/massachusetts/">
          <strong>Massachusetts — Assisted Living</strong>
          <span>State median $7,250/mo</span>
        </a>
        <a class="sl-state-market-link" href="/guides/costs/memory-care/hawaii/">
          <strong>Hawaii — Memory Care</strong>
          <span>State median $11,000/mo</span>
        </a>
        <a class="sl-state-market-link" href="/guides/costs/assisted-living/louisiana/">
          <strong>Louisiana — Assisted Living</strong>
          <span>State median $3,983/mo</span>
        </a>
        <a class="sl-state-market-link" href="/guides/costs/memory-care/wyoming/">
          <strong>Wyoming — Memory Care</strong>
          <span>State median $4,025/mo</span>
        </a>
      </div>
      <p style="margin-top:1rem;font-size:0.9rem;color:var(--muted);">
        <a href="/assisted-living/">Browse the full directory</a> to find state-level cost guides for all 51 states.
      </p>
    </section>
  </div>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
</Base>
