---
import Base from '../../layouts/Base.astro';

const title = 'Senior Living Guides | SilverTech Directory';
const description = 'Evidence-based guides for dementia families covering emotional stress, care decisions, and real memory care costs.';
const canonical = 'https://silvertechdirectory.com/guides/';

const guides = [
  {
    href: '/guides/hidden-costs-of-memory-care/',
    title: 'Hidden Costs of Memory Care: What Families Are Never Told Up Front',
    summary: 'Care levels, medication fees, supply charges, and contract terms that drive the real monthly bill.'
  },
  {
    href: '/guides/guilt-about-placing-parent-in-memory-care/',
    title: 'Guilt About Placing a Parent in Memory Care',
    summary: 'How to separate guilt from grief and make safer decisions without abandoning love.'
  },
  {
    href: '/guides/grief-while-parent-is-still-alive-dementia/',
    title: 'Grief While Parent Is Still Alive With Dementia',
    summary: 'A practical guide to ambiguous loss and emotional stabilization for caregivers.'
  },
  {
    href: '/guides/caregiver-resentment-toward-parent/',
    title: 'Caregiver Resentment Toward Parent',
    summary: 'Why resentment appears, how to reduce overload, and when to reset the care model.'
  },
  {
    href: '/guides/sibling-not-helping-parent-care/',
    title: 'Sibling Not Helping With Parent Care',
    summary: 'Scripts, workload models, and decision frameworks when family support is uneven.'
  },
  {
    href: '/guides/caregiver-at-breaking-point/',
    title: 'I Cannot Do This Anymore Caring for My Parent',
    summary: 'High-urgency steps for caregiver crisis stabilization and emergency care planning.'
  }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://silvertechdirectory.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: canonical }
  ]
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: guides.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://silvertechdirectory.com${guide.href}`,
    name: guide.title
  }))
};
---

<Base title={title} description={description} canonical={canonical}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>

  <section class="container guide-shell">
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <span>Guides</span>
    </nav>

    <div class="guide-hero">
      <picture class="hero-image">
        <source srcset="/hero.avif" type="image/avif" />
        <source srcset="/hero.webp" type="image/webp" />
        <img
          src="/hero.png"
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          alt="SilverTech senior living guides"
        />
      </picture>
      <div class="guide-hero-content">
        <p class="eyebrow">SilverTech Editorial Hub</p>
        <h1>Senior Living Guides for Real Family Decisions</h1>
        <p>
          These guides target practical and emotional questions families ask during dementia care. Every page is written for
          clarity under stress, with direct paths to compare licensed communities when you are ready.
        </p>
      </div>
    </div>
  </section>

  <section class="container" style="padding: 0 1.5rem 2.5rem;">
    <div class="card">
      <div class="section-head">
        <h2>Featured Guides</h2>
        <a href="/search">Browse care options</a>
      </div>
      <ul class="guide-list">
        {guides.map((guide) => (
          <li>
            <a href={guide.href}>{guide.title}</a>
            <p>{guide.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    .guide-shell {
      padding: 2rem 1.5rem 1rem;
    }

    .breadcrumbs {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #64748b;
      margin-bottom: 1rem;
    }

    .guide-hero {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      min-height: 320px;
      border: 1px solid #e2e8f0;
      background: #0f172a;
    }

    .hero-image img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) brightness(0.34);
    }

    .guide-hero-content {
      position: relative;
      z-index: 1;
      padding: 2rem;
      max-width: 760px;
      color: #f8fafc;
      background: linear-gradient(90deg, rgba(15, 23, 42, 0.92), rgba(15, 23, 42, 0.58), rgba(15, 23, 42, 0));
      min-height: 320px;
      display: grid;
      align-content: center;
      gap: 0.85rem;
    }

    .eyebrow {
      margin: 0;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #facc15;
      font-weight: 700;
    }

    .guide-hero-content h1 {
      margin: 0;
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      line-height: 1.14;
    }

    .guide-hero-content p {
      margin: 0;
      color: rgba(248, 250, 252, 0.94);
      line-height: 1.6;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .section-head h2 {
      margin: 0;
      font-size: 1.3rem;
    }

    .section-head a {
      color: #ca8a04;
      font-weight: 700;
      font-size: 0.9rem;
    }

    .guide-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.8rem;
    }

    .guide-list li {
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 0.9rem;
      background: #fff;
    }

    .guide-list a {
      color: #0f172a;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .guide-list p {
      margin: 0.45rem 0 0;
      color: #475569;
      line-height: 1.55;
      font-size: 0.95rem;
    }
  </style>
</Base>
