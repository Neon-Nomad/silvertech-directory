const relatedLinks = [
  { href: '/guides/what-families-miss-state-regulations/', label: 'What families miss without reviewing state regulations' },
  { href: '/guides/assisted-living-vs-nursing-home-real-differences/', label: 'Assisted living vs nursing home: real differences' },
