const description = 'An answer-first guide to senior care costs by level of care and state context. See real monthly ranges, what increases pricing, what Medicaid and Medicare do or do not cover, and how to estimate true monthly cost.';
const canonical = 'https://silvertechdirectory.com/guides/senior-care-costs-explained-what-you-actually-pay/';
const ogImage = 'https://silvertechdirectory.com/hero.png';

const h1 = 'Senior Care Costs Explained: What You Actually Pay (By State + Level of Care)';
const deck = 'Families search cost first, but most estimates miss the biggest drivers. This guide explains what you actually pay by care level, why monthly cost rises, and how state rules change payment options.';

const toc = [
  { id: 'definition-block', label: 'Definition block: what drives cost' },
  { id: 'direct-answer', label: 'Direct answer: typical monthly ranges' },
  { id: 'cost-table', label: 'Side-by-side cost table' },
