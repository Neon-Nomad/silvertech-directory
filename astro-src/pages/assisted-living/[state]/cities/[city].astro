---
import Base from '../../../../layouts/Base.astro';
import { getCityIndex, getCityFacilities } from '../../../../lib/data';
import { CITY_COORDINATES } from '../../../../../src/data/city_coordinates';

export async function getStaticPaths() {
  const cities = getCityIndex();
  return cities.map((c) => ({
    params: { state: c.stateSlug, city: c.citySlug },
    props: c
  }));
}

const { stateSlug, citySlug, cityName, stateName, stateAbbr } = Astro.props;
const facilities = getCityFacilities(stateSlug, citySlug, 50);
const featuredFacilities = facilities.slice(0, 12);
const toRad = (degrees: number) => (degrees * Math.PI) / 180;
const distanceKm = (a: [number, number], b: [number, number]) => {
  const earthRadiusKm = 6371;
  const dLat = toRad(b[0] - a[0]);
  const dLng = toRad(b[1] - a[1]);
  const lat1 = toRad(a[0]);
  const lat2 = toRad(b[0]);

  const sinDLat = Math.sin(dLat / 2);
  const sinDLng = Math.sin(dLng / 2);
  const h = sinDLat * sinDLat + Math.cos(lat1) * Math.cos(lat2) * sinDLng * sinDLng;
  const c = 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
  return earthRadiusKm * c;
};

const currentCoord = CITY_COORDINATES[citySlug];
const relatedCities = getCityIndex()
  .filter((city) => city.stateSlug === stateSlug && city.citySlug !== citySlug)
  .map((city) => {
    const candidateCoord = CITY_COORDINATES[city.citySlug];
    const distance = currentCoord && candidateCoord ? distanceKm(currentCoord, candidateCoord) : null;
    return { ...city, distanceKm: distance };
  })
  .sort((a, b) => {
    if (a.distanceKm !== null && b.distanceKm !== null) return a.distanceKm - b.distanceKm;
    if (a.distanceKm !== null) return -1;
    if (b.distanceKm !== null) return 1;
    return a.cityName.localeCompare(b.cityName);
  })
  .slice(0, 5);
const cityKey = `${stateSlug}/${citySlug}`;

const cityKeywordTargets = [
  `senior care in ${cityName}, ${stateAbbr}`,
  `senior living in ${cityName}, ${stateAbbr}`,
  `assisted living in ${cityName}, ${stateAbbr}`,
  `memory care in ${cityName}, ${stateAbbr}`,
  `nursing homes in ${cityName}, ${stateAbbr}`,
  `independent living in ${cityName}, ${stateAbbr}`,
  `assisted living cost in ${cityName}, ${stateAbbr}`,
  `memory care cost in ${cityName}, ${stateAbbr}`
];

const title = `Senior Care in ${cityName}, ${stateAbbr} | Assisted Living, Memory Care & Nursing Homes`;
const description = `Compare senior care in ${cityName}, ${stateName}, including assisted living, memory care, nursing homes, and independent living. View licensed communities and transparent listings.`;
const keywords = cityKeywordTargets.join(', ');
const canonical = `https://silvertechdirectory.com/assisted-living/${stateSlug}/cities/${citySlug}/`;
const searchHref = `/search?state=${encodeURIComponent(stateAbbr)}&city=${encodeURIComponent(cityName)}`;
const isMemoryCareFacility = (facility: { name?: string; facility_type?: string }) => {
  const descriptor = `${facility.facility_type || ''} ${facility.name || ''}`.toLowerCase();
  return /memory|dementia|alzheimer/.test(descriptor);
};
const memoryCareFacilityCount = facilities.filter((facility) => isMemoryCareFacility(facility)).length;
const shouldShowDecisionGuides = memoryCareFacilityCount >= 3;

const normalizeCareType = (value?: string) => {
  const raw = (value || '').trim().toLowerCase();
  if (!raw) return 'assisted living';
  if (/memory|dementia|alzheimer/.test(raw)) return 'memory care';
  if (/nursing|skilled|snf/.test(raw)) return 'nursing home care';
  if (/independent/.test(raw)) return 'independent living';
  if (/respite/.test(raw)) return 'respite care';
  return raw.replace(/[_-]+/g, ' ');
};

const careTypeCounts = new Map<string, number>();
const postalCodeCounts = new Map<string, number>();
for (const facility of facilities) {
  const careType = normalizeCareType(facility.facility_type || facility.type);
  careTypeCounts.set(careType, (careTypeCounts.get(careType) || 0) + 1);

  const postal = (facility.postal_code || '').trim().slice(0, 5);
  if (postal) postalCodeCounts.set(postal, (postalCodeCounts.get(postal) || 0) + 1);
}

const topCareTypes = Array.from(careTypeCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);
const topCareTypeText = topCareTypes.map(([type, count]) => `${type} (${count})`).join(', ') || 'assisted living';

const topPostalCodes = Array.from(postalCodeCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3)
  .map(([postal]) => postal);
const zipCoverageText = topPostalCodes.length > 0 ? topPostalCodes.join(', ') : `${cityName} area`;

const phoneCoveragePct = facilities.length
  ? Math.round((facilities.filter((facility) => Boolean(facility.phone)).length / facilities.length) * 100)
  : 0;
const websiteCoveragePct = facilities.length
  ? Math.round((facilities.filter((facility) => Boolean(facility.website_url)).length / facilities.length) * 100)
  : 0;

const decisionGuideLinks = [
  {
    href: '/guides/guilt-about-placing-parent-in-memory-care/',
    label: 'Guilt About Placing a Parent in Memory Care'
  },
  {
    href: '/guides/caregiver-at-breaking-point/',
    label: 'I Cannot Do This Anymore Caring for My Parent'
  }
];

type DiningSpot = {
  name: string;
  href: string;
  note: string;
  sponsored?: boolean;
};

const curatedDiningByCity: Record<string, DiningSpot[]> = {
  'texas/dallas': [
    {
      name: 'Pecan Lodge',
      href: 'https://www.google.com/maps/search/?api=1&query=Pecan+Lodge+Dallas+TX',
      note: 'BBQ spot with easier lunch timing for family visits'
    },
    {
      name: 'Celebration Restaurant',
      href: 'https://www.google.com/maps/search/?api=1&query=Celebration+Restaurant+Dallas+TX',
      note: 'Comfort-food menu with lighter options'
    },
    {
      name: 'Bread Winners Cafe',
      href: 'https://www.google.com/maps/search/?api=1&query=Bread+Winners+Cafe+Dallas+TX',
      note: 'Brunch and bakery options near central Dallas'
    },
    {
      name: 'Dallas Family Diner Picks',
      href: '/advertise',
      note: 'Featured local dining placements for providers and partners',
      sponsored: true
    }
  ]
};

const fallbackDining: DiningSpot[] = [
  {
    name: `${cityName} low-sodium options`,
    href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`low sodium restaurants in ${cityName} ${stateAbbr}`)}`,
    note: 'Search map results for lower-sodium menus'
  },
  {
    name: `${cityName} family lunch spots`,
    href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`family lunch near assisted living in ${cityName} ${stateAbbr}`)}`,
    note: 'Good options for post-tour meals'
  },
  {
    name: `${cityName} quiet restaurants`,
    href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`quiet restaurants in ${cityName} ${stateAbbr}`)}`,
    note: 'Lower-noise environments for older adults'
  }
];

const diningSpots = curatedDiningByCity[cityKey] || fallbackDining;

const facilityCountText = facilities.length.toLocaleString();
const profileCoverageText = featuredFacilities.length.toLocaleString();
const withPhoneCountText = facilities.filter((f) => Boolean(f.phone)).length.toLocaleString();

const formatAddress = (facility: {
  address_line1?: string;
  city?: string;
  state?: string;
  postal_code?: string;
}) => {
  const line1 = facility.address_line1 || '';
  const line2 = [facility.city, facility.state, facility.postal_code].filter(Boolean).join(', ').replace(', ,', ',');
  return `${line1}${line1 && line2 ? ', ' : ''}${line2}`;
};

const toMapHref = (facility: {
  name?: string;
  city?: string;
  state?: string;
  google_maps_url?: string;
}) => {
  if (facility.google_maps_url) return facility.google_maps_url;
  const query = `${facility.name || 'Assisted Living'} ${facility.city || cityName} ${facility.state || stateAbbr}`;
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
};

const faqItems = [
  {
    question: `What is the average monthly cost of assisted living in ${cityName}?`,
    answer: `Pricing in ${cityName} varies by care level, floor plan, and amenities. Compare multiple licensed communities and request itemized pricing for base rent, care fees, and move-in costs.`
  },
  {
    question: `How often are facilities in ${cityName} inspected?`,
    answer: `Licensing and oversight cadence is managed at the ${stateName} state level. Use the official regulatory resources and complaint channels linked on this page to verify current compliance details.`
  },
  {
    question: `Can I contact facilities directly from this directory?`,
    answer: `Yes. Each listing routes to a profile page with available phone and contact details so families can compare and reach communities directly.`
  },
  {
    question: `How do I compare nearby cities if options are limited in ${cityName}?`,
    answer: `Use the nearby city links at the bottom of this page to evaluate adjacent markets in ${stateName} while keeping travel distance and family access in mind.`
  }
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': title,
  'description': description,
  'keywords': cityKeywordTargets,
  'url': canonical,
  'isPartOf': {
    '@type': 'WebSite',
    'name': 'SilverTech Directory',
    'url': 'https://silvertechdirectory.com/'
  }
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'itemListElement': featuredFacilities.map((f, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'item': {
      '@type': 'LocalBusiness',
      'name': f.name,
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': f.address_line1 || '',
        'addressLocality': f.city || '',
        'addressRegion': f.state || '',
        'postalCode': f.postal_code || '',
        'addressCountry': 'US'
      },
      'telephone': f.phone || undefined,
      'url': `https://silvertechdirectory.com/facility/${f.id}/`
    }
  }))
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://silvertechdirectory.com/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Assisted Living', 'item': 'https://silvertechdirectory.com/assisted-living' },
    { '@type': 'ListItem', 'position': 3, 'name': stateName, 'item': `https://silvertechdirectory.com/assisted-living/${stateSlug}/` },
    { '@type': 'ListItem', 'position': 4, 'name': cityName, 'item': canonical }
  ]
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
};
---
<Base title={title} description={description} canonical={canonical}>
  <meta slot="head" name="keywords" content={keywords} />
  <section class="container" style="padding: 2rem 1.5rem;">
    <h1 class="sr-only">Senior Care in {cityName}, {stateAbbr}</h1>
    <div class="crawl-priority-signals">
      <h2>Local Data Signals</h2>
      <p class="decision-copy">
        Real listing-level distribution for {cityName}: {topCareTypeText}. ZIP concentration focus: {zipCoverageText}.
      </p>
      <ul class="simple-list compact">
        <li><strong>Facilities indexed:</strong> {facilityCountText}</li>
        <li><strong>Listings with phone:</strong> {phoneCoveragePct}%</li>
        <li><strong>Listings with website:</strong> {websiteCoveragePct}%</li>
      </ul>
    </div>
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <a href={`/assisted-living/${stateSlug}/`}>{stateName}</a>
      <span>/</span>
      <span>{cityName}</span>
    </nav>
    <div class="city-hero">
      <picture class="hero-image">
        <source srcset="/hero.avif" type="image/avif" />
        <source srcset="/hero.webp" type="image/webp" />
        <img
          src="/hero.png"
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          alt={`${cityName}, ${stateAbbr} assisted living overview`}
        />
      </picture>
      <div class="city-hero-content">
        <p class="eyebrow">City Licensing Snapshot</p>
        <p class="hero-title">Senior Care in {cityName}, {stateAbbr}</p>
        <p>
          Compare assisted living, memory care, nursing homes, and independent living options with licensed community profiles and nearby alternatives in {stateName}.
        </p>
        <div class="hero-stats">
          <span><strong>{facilityCountText}</strong> city facilities indexed</span>
          <span><strong>{withPhoneCountText}</strong> listings with phone contacts</span>
          <span><strong>{profileCoverageText}</strong> featured profile links below</span>
        </div>
        <div class="hero-cta">
          <a class="btn-primary" href={searchHref}>Browse {cityName} directory</a>
          <a class="btn-secondary" href={`/assisted-living/${stateSlug}/`}>View {stateName} statewide page</a>
        </div>
      </div>
    </div>
    <div class="meta" style="margin-top: 1rem;">
      <div><strong>Author:</strong> SilverTech Editorial Team</div>
      <div><strong>Last updated:</strong> February 21, 2026</div>
    </div>
    <div class="note" style="margin-top: 0.75rem;">
      <strong>Data source:</strong> Data is compiled from public records and official state licensing authorities.
      Learn more in our <a href="/editorial-policy" style="color:#2563eb; text-decoration: underline;">Editorial Policy</a>.
    </div>
  </section>

  <section class="container city-layout">
    <div class="card main-card">
      <div class="section-head">
        <h2>Featured Licensed Facilities in {cityName}</h2>
        <a href={searchHref}>View all city results</a>
      </div>
      <p class="decision-copy">
        Families searching for <strong>senior care in {cityName}</strong> can use this page to compare
        <strong> assisted living in {cityName}</strong>, <strong>memory care in {cityName}</strong>,
        and <strong>nursing homes in {cityName}</strong> in one place.
      </p>
      {facilities.length === 0 ? (
        <p class="muted">No facilities found in this city yet. Check a nearby city or browse the state page.</p>
      ) : (
        <ul class="facility-grid">
          {featuredFacilities.map((facility) => (
            <li key={facility.id}>
              <article class="facility-card">
                <h3><a href={`/facility/${facility.id}/`}>{facility.name}</a></h3>
                <p class="muted">{formatAddress(facility)}</p>
                <p class="facility-links">
                  <a href={`/facility/${facility.id}/`}>View profile</a>
                  <a href={toMapHref(facility)} target="_blank" rel="noopener nofollow noreferrer">View map</a>
                  {facility.website_url && (
                    <a href={facility.website_url} target="_blank" rel="noopener nofollow noreferrer">Visit website</a>
                  )}
                </p>
              </article>
            </li>
          ))}
        </ul>
      )}
    </div>

    <aside class="side-stack">
      <section class="card">
        <h2>City Resource Links</h2>
        <ul class="simple-list">
          <li><a href={`/states/${stateSlug}/regulations`}>{stateName} regulations</a></li>
          <li><a href={`/states/${stateSlug}/medicaid`}>{stateName} Medicaid resources</a></li>
          <li><a href={`/states/${stateSlug}/ombudsman`}>{stateName} ombudsman contacts</a></li>
          <li><a href={searchHref}>Assisted living search in {cityName}</a></li>
        </ul>
      </section>

      <section class="card">
        <div class="section-head compact">
          <h2>Dining Near {cityName} Facilities</h2>
          <a href={`/advertise`}>Partner</a>
        </div>
        <ul class="simple-list">
          {diningSpots.map((spot) => (
            <li key={spot.name}>
              <a href={spot.href} target={spot.href.startsWith('http') ? '_blank' : undefined} rel={spot.href.startsWith('http') ? 'noopener nofollow noreferrer' : undefined}>
                {spot.name}
              </a>
              {spot.sponsored && <span class="sponsored-pill">Sponsored</span>}
              <p class="muted">{spot.note}</p>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </section>

  <section class="container" style="padding: 0 1.5rem 2.5rem;">
    <div class="card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqItems.map((faq) => (
          <details key={faq.question}>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {shouldShowDecisionGuides && (
    <section class="container" style="padding: 0 1.5rem 2.5rem;">
      <div class="card">
        <h2>Supporting Families Through Decision-Making</h2>
        <p class="decision-copy">
          {cityName} includes {memoryCareFacilityCount.toLocaleString()} memory-care-relevant listings. These guides can help families decide next steps with less stress.
        </p>
        <ul class="simple-list">
          {decisionGuideLinks.map((guide) => (
            <li key={guide.href}>
              <a href={guide.href}>{guide.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="container" style="padding: 0 1.5rem 2.5rem;">
    <div class="card">
      <h2>Nearby City Navigation</h2>
      {relatedCities.length === 0 ? (
        <p class="muted">No nearby city pages are available yet.</p>
      ) : (
        <ul class="nearby-grid">
          {relatedCities.map((relatedCity) => (
            <li key={`${relatedCity.stateSlug}-${relatedCity.citySlug}`}>
              <a href={`/assisted-living/${relatedCity.stateSlug}/cities/${relatedCity.citySlug}/`}>
                Assisted living in {relatedCity.cityName}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <style>
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .crawl-priority-signals {
      margin-bottom: 1rem;
      border: 1px solid #dbeafe;
      border-radius: 10px;
      padding: 0.8rem 0.9rem;
      background: #eff6ff;
    }
    .crawl-priority-signals h2 {
      margin: 0;
      font-size: 1rem;
    }
    .simple-list.compact {
      margin-top: 0.6rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
    }
    .simple-list.compact li {
      padding: 0.5rem 0.6rem;
      font-size: 0.82rem;
    }
    .breadcrumbs {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #64748b;
      margin-bottom: 1rem;
    }
    .city-hero {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      min-height: 360px;
      border: 1px solid #e2e8f0;
      background: #0f172a;
    }
    .hero-image img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) brightness(0.38);
    }
    .city-hero-content {
      position: relative;
      z-index: 1;
      padding: 2rem;
      max-width: 720px;
      color: #f8fafc;
      background: linear-gradient(90deg, rgba(15, 23, 42, 0.92), rgba(15, 23, 42, 0.5), rgba(15, 23, 42, 0));
      min-height: 360px;
      display: grid;
      align-content: center;
      gap: 0.75rem;
    }
    .eyebrow {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #facc15;
      margin: 0;
      font-weight: 700;
    }
    .hero-title {
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      margin: 0;
      line-height: 1.15;
      font-weight: 800;
    }
    .city-hero-content p {
      margin: 0;
      color: rgba(248, 250, 252, 0.92);
    }
    .hero-stats {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      font-size: 0.9rem;
    }
    .hero-stats span {
      background: rgba(15, 23, 42, 0.64);
      border: 1px solid rgba(226, 232, 240, 0.2);
      border-radius: 999px;
      padding: 0.35rem 0.75rem;
    }
    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }
    .btn-primary,
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      padding: 0.7rem 1rem;
      font-weight: 700;
      font-size: 0.95rem;
      border: 1px solid transparent;
    }
    .btn-primary {
      background: #facc15;
      color: #0f172a;
    }
    .btn-secondary {
      border-color: rgba(226, 232, 240, 0.4);
      color: #f8fafc;
      background: rgba(15, 23, 42, 0.32);
    }
    .city-layout {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
      gap: 1rem;
      padding: 0 1.5rem 2rem;
    }
    .main-card h2,
    .side-stack h2,
    .card h2 {
      margin: 0;
      font-size: 1.2rem;
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .section-head a {
      font-size: 0.85rem;
      color: #ca8a04;
      font-weight: 700;
    }
    .section-head.compact h2 {
      font-size: 1.05rem;
    }
    .side-stack {
      display: grid;
      gap: 1rem;
      align-content: start;
    }
    .facility-grid {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.75rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .facility-card {
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 0.8rem;
      background: #fff;
    }
    .facility-card h3 {
      margin: 0 0 0.35rem;
      font-size: 1rem;
      line-height: 1.25;
    }
    .facility-card h3 a {
      color: #0f172a;
      text-decoration: none;
    }
    .facility-card h3 a:hover {
      text-decoration: underline;
    }
    .facility-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.8rem;
      margin: 0.7rem 0 0;
    }
    .facility-links a {
      font-size: 0.8rem;
      color: #ca8a04;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      font-weight: 700;
