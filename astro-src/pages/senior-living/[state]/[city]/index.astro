---
import Base from '../../../../layouts/Base.astro';
import MapIsland from '../../../../components/senior/MapIsland';
import FeaturedCommunities from '../../../../components/senior/FeaturedCommunities';
import { ALL_STATES } from '../../../../../src/data/states';
import { getAllCities, getFacilitiesByCity, getCityStats, getNearbyCities } from '../../../../lib/seniorDataContract';
import {
  getSeniorLivingCity,
  getCareTypes,
  getCareTypeLabel,
  getCityMapPoints,
  getRegulatoryContext,
  getHospitalsForCity,
  getBuildDate,
  formatDateLong,
  formatCurrency,
  getCostBand,
  getCareTypeBySlug,
} from '../../../../lib/seniorLivingData';

export async function getStaticPaths() {
  const cities = await getAllCities();
  return cities.map(({ state, city }) => ({ params: { state, city } }));
}

const { state: stateSlug, city: citySlug } = Astro.params;
const toTitleCase = (value: string) =>
  value
    .split('-')
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');

const stateMetaBySlug = new Map(ALL_STATES.map((state) => [state.slug, state]));
const stateMeta =
  stateSlug
    ? stateMetaBySlug.get(stateSlug) ||
      ALL_STATES.find((state) => state.abbreviation.toLowerCase() === stateSlug.toLowerCase()) ||
      null
    : null;

const buildFallbackCityData = async () => {
  if (!stateSlug || !citySlug) return null;

  const normalizedFacilities = await getFacilitiesByCity(stateSlug, citySlug);
  if (normalizedFacilities.length === 0) return null;

  const cityStats = await getCityStats(stateSlug, citySlug);
  const nearby = await getNearbyCities(stateSlug, citySlug);

  const cityName = normalizedFacilities[0]?.city || toTitleCase(citySlug);
  const zipCounts = new Map<string, number>();
  for (const facility of normalizedFacilities) {
    const zip = (facility.postalCode || '').trim();
    if (!zip) continue;
    zipCounts.set(zip, (zipCounts.get(zip) || 0) + 1);
  }
  const topZips = Array.from(zipCounts.entries())
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, 5)
    .map(([zip]) => zip);

  const withPhone = normalizedFacilities.filter((facility) => Boolean(facility.phone)).length;
  const withWebsite = normalizedFacilities.filter((facility) => Boolean(facility.websiteUrl)).length;
  const dominantCareType =
    Object.entries(cityStats.careTypeCounts).sort((a, b) => b[1] - a[1])[0]?.[0] || 'assisted-living';

  const geoFacilities = normalizedFacilities.filter(
    (facility) => facility.latitude !== null && facility.longitude !== null,
  );
  const center =
    geoFacilities.length > 0
      ? {
          lat: geoFacilities.reduce((sum, facility) => sum + (facility.latitude || 0), 0) / geoFacilities.length,
          lng: geoFacilities.reduce((sum, facility) => sum + (facility.longitude || 0), 0) / geoFacilities.length,
        }
      : null;

  const facilities = normalizedFacilities.map((facility) => ({
    id: facility.id,
    name: facility.name,
    city: facility.city,
    state: facility.state,
    street: facility.address,
    zip: facility.postalCode,
    phone: facility.phone,
    verifiedPhone: null,
    websiteUrl: facility.websiteUrl,
    googleMapsUrl: null,
    careTypes: facility.careTypes,
    ownershipType: facility.ownershipType,
    licenseNumber: facility.licenseNumber,
    listingTier: facility.listingTier,
  }));

  return {
    stateSlug: stateMeta?.slug || stateSlug,
    citySlug: citySlug,
    stateAbbr: stateMeta?.abbreviation || stateSlug.toUpperCase(),
    stateName: stateMeta?.name || (stateSlug.length === 2 ? stateSlug.toUpperCase() : toTitleCase(stateSlug)),
    cityName,
    careTypeCounts: cityStats.careTypeCounts,
    facilities,
    facilityCount: facilities.length,
    topZips,
    richContent: null,
    center,
    nearbyCities: nearby.map((item) => ({
      stateSlug: item.state,
      citySlug: item.slug,
      cityName: toTitleCase(item.slug),
      facilityCount: item.facilityCount,
      distanceMiles: item.distanceMiles === 9999 ? null : item.distanceMiles,
    })),
    stats: {
      totalFacilities: cityStats.totalFacilities,
      withPhone,
      withWebsite,
      phoneCoveragePct: cityStats.totalFacilities === 0 ? 0 : Math.round((withPhone / cityStats.totalFacilities) * 100),
      websiteCoveragePct:
        cityStats.totalFacilities === 0 ? 0 : Math.round((withWebsite / cityStats.totalFacilities) * 100),
      dominantCareType,
      medicareCertifiedPct: cityStats.medicareCertifiedPct,
    },
  };
};

let cityData = stateSlug && citySlug ? getSeniorLivingCity(stateSlug, citySlug) : null;
if (!cityData) {
  cityData = await buildFallbackCityData();
}

if (!cityData) {
  throw new Error(`City page not found for ${stateSlug || 'unknown'}/${citySlug || 'unknown'}`);
}

const buildDate = getBuildDate();
const buildDateLabel = formatDateLong(buildDate);
const title = `Senior Living in ${cityData.cityName}, ${cityData.stateName}`;
const description = `Local senior living guide for ${cityData.cityName}, ${cityData.stateName} with care type coverage, cost context, nearby hospitals, regulatory references, and facility-level records.`;
const canonical = `https://silvertechdirectory.com/senior-living/${cityData.stateSlug}/${cityData.citySlug}/`;
const careTypes = getCareTypes();
const activeCareTypes = careTypes.filter((care) => cityData.careTypeCounts[care.slug] > 0);
const mapPoints = getCityMapPoints(cityData.stateSlug, cityData.citySlug);
const regulatory = getRegulatoryContext(cityData.stateSlug);
const hospitals = getHospitalsForCity(cityData.stateAbbr, cityData.cityName, 4);
const hospitalMapPoints = hospitals
  .map((hospital, index) => ({
    id: `${cityData.stateSlug}-${cityData.citySlug}-${index}-${hospital.name}`,
    name: hospital.name,
    lat: Number(hospital.latitude),
    lng: Number(hospital.longitude),
    address: [hospital.address, `${hospital.city || cityData.cityName}, ${hospital.state || cityData.stateAbbr} ${hospital.zip || ''}`]
      .filter(Boolean)
      .join(', '),
    type: hospital.type || 'Hospital',
  }))
  .filter((hospital) => Number.isFinite(hospital.lat) && Number.isFinite(hospital.lng));

const careColors = Object.fromEntries(careTypes.map((care) => [care.slug, care.mapColor]));

const topFacilities = [...cityData.facilities]
  .sort((a, b) => {
    const aScore = Number(Boolean(a.websiteUrl)) + Number(Boolean(a.phone || a.verifiedPhone)) + Number(a.careTypes.length > 1);
    const bScore = Number(Boolean(b.websiteUrl)) + Number(Boolean(b.phone || b.verifiedPhone)) + Number(b.careTypes.length > 1);
    if (bScore !== aScore) return bScore - aScore;
    return a.name.localeCompare(b.name);
  })
  .slice(0, 24);

const assistedCost = getCostBand('assisted-living');
const memoryCost = getCostBand('memory-care');
const nursingCost = getCostBand('nursing-homes');

const marketOverviewParagraph = cityData.richContent
  ? `In ${cityData.cityName}, ${cityData.stateName}, senior care demand is supported by a mix of local neighborhoods and regional referral patterns. SilverTech currently indexes ${cityData.facilityCount.toLocaleString()} licensed communities in this city, with strongest inventory concentration in ZIP codes ${cityData.topZips.join(', ') || 'across the local market'}.`
  : `SilverTech currently indexes ${cityData.facilityCount.toLocaleString()} licensed senior care communities in ${cityData.cityName}, ${cityData.stateName}. These listings include assisted living, memory care, nursing homes, and other long-term care formats regulated through statewide licensing channels. ZIP concentration is strongest in ${cityData.topZips.join(', ') || 'the core city footprint'}, which typically aligns with larger care campuses and rehabilitation corridors.`;

const faqItems = [
  {
    question: `What is the average cost of assisted living in ${cityData.cityName}?`,
    answer: `Assisted living in ${cityData.cityName} is often planned in a broad range of ${formatCurrency(assistedCost.low)} to ${formatCurrency(assistedCost.high)} per month, but final pricing can move higher based on care level, staffing intensity, and room configuration. Memory care usually sits above assisted living because secure environments and dementia-trained staffing increase operating cost. The best way to compare pricing is to request itemized fee sheets from multiple facilities and separate room-and-board charges from care-service charges.`,
  },
  {
    question: `How many senior care facilities are tracked in ${cityData.cityName}?`,
    answer: `SilverTech currently tracks ${cityData.facilityCount.toLocaleString()} facilities in ${cityData.cityName}. This includes communities that provide a single care type and communities with multi-care offerings displayed as badges on each record. Coverage is refreshed from normalized public datasets and online presence updates, so families and market analysts can compare not only facility counts but also website and phone contact coverage before outreach.`,
  },
  {
    question: `Are memory care communities available in ${cityData.cityName}?`,
    answer: `Yes. Memory care availability in ${cityData.cityName} is represented in this city index and linked from the care-type filter chips at the top of the page. Some communities are memory-care-exclusive, while others offer memory care as one of several services in a broader senior living campus. Reviewing badges and care-type pages together helps families identify whether a community is specialized or mixed-model before scheduling tours.`,
  },
  {
    question: `Does ${cityData.stateName} Medicaid support long-term care services in ${cityData.cityName}?`,
    answer: `${regulatory.medicaid?.programName || 'State Medicaid waiver programs'} may help cover portions of long-term care services in ${cityData.cityName}, but covered services and eligibility differ by care setting and individual qualification. Families should confirm both waiver eligibility and the facility's Medicaid acceptance policy before assuming a specific monthly out-of-pocket amount.`,
  },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://silvertechdirectory.com/' },
    { '@type': 'ListItem', position: 2, name: 'Senior Care', item: 'https://silvertechdirectory.com/senior-living/' },
    { '@type': 'ListItem', position: 3, name: cityData.stateName, item: `https://silvertechdirectory.com/senior-living/${cityData.stateSlug}/` },
    { '@type': 'ListItem', position: 4, name: cityData.cityName, item: canonical },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: topFacilities.map((facility, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'MedicalBusiness',
      name: facility.name,
      url: `https://silvertechdirectory.com/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${facility.id}/`,
      telephone: facility.verifiedPhone || facility.phone || undefined,
      identifier: facility.licenseNumber
        ? {
            '@type': 'PropertyValue',
            propertyID: 'state_license_number',
            value: facility.licenseNumber,
          }
        : undefined,
      address: {
        '@type': 'PostalAddress',
        streetAddress: facility.street || '',
        addressLocality: facility.city,
        addressRegion: facility.state,
        postalCode: facility.zip || '',
        addressCountry: 'US',
      },
    },
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---
<Base title={title} description={description} canonical={canonical}>
  <link slot="head" rel="stylesheet" href="/styles/senior-living.css" />

  <div class="container sl-page">
    <nav class="sl-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href={`/senior-living/${cityData.stateSlug}/`}>{cityData.stateName}</a>
      <span>/</span>
      <span>{cityData.cityName}</span>
    </nav>

    <section class="sl-hero">
      <p class="sl-eyebrow">City Senior Living Hub</p>
      <h1>Senior Living in {cityData.cityName}, {cityData.stateName}</h1>
      <p>
        Compare care categories, facility records, local healthcare support, and pricing context in {cityData.cityName}.
        This city page is designed to function as an authority hub that connects market analysis with actionable listings.
      </p>
      <div class="sl-hero-meta">
        <span><strong>{cityData.facilityCount.toLocaleString()}</strong> facilities indexed</span>
        <span><strong>{cityData.stats.withPhone.toLocaleString()}</strong> listings with phone</span>
        <span><strong>{cityData.stats.withWebsite.toLocaleString()}</strong> listings with website</span>
      </div>
      <div class="sl-hero-actions">
        <a class="sl-btn sl-btn-primary" href={`/search?state=${encodeURIComponent(cityData.stateAbbr)}&city=${encodeURIComponent(cityData.cityName)}`}>Browse Facilities</a>
        <a class="sl-btn sl-btn-secondary" href={`/senior-living/${cityData.stateSlug}/`}>View Statewide Page</a>
      </div>
    </section>

    <section class="sl-stats-grid">
      <article class="sl-stat">
        <p class="k">Facilities Indexed</p>
        <p class="v">{cityData.stats.totalFacilities.toLocaleString()}</p>
        <p class="s">City-level tracking footprint</p>
      </article>
      <article class="sl-stat">
        <p class="k">Phone Coverage</p>
        <p class="v">{cityData.stats.phoneCoveragePct}%</p>
        <p class="s">{cityData.stats.withPhone.toLocaleString()} records with contact numbers</p>
      </article>
      <article class="sl-stat">
        <p class="k">Website Coverage</p>
        <p class="v">{cityData.stats.websiteCoveragePct}%</p>
        <p class="s">{cityData.stats.withWebsite.toLocaleString()} records with websites</p>
      </article>
      <article class="sl-stat">
        <p class="k">ZIP Clusters</p>
        <p class="v" style="font-size:1.05rem">{cityData.topZips.join(', ') || 'N/A'}</p>
        <p class="s">Strongest concentration zones</p>
      </article>
    </section>

    <nav class="sl-care-tabs" aria-label="Care type filters">
      {activeCareTypes.map((care) => (
        <a href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${care.slug}/`}>
          {care.label} ({cityData.careTypeCounts[care.slug].toLocaleString()})
        </a>
      ))}
    </nav>

    <section style="margin-top:1rem;">
      <MapIsland
        points={mapPoints}
        hospitals={hospitalMapPoints}
        fallbackCenter={cityData.center || { lat: 39.8283, lng: -98.5795 }}
        careColors={careColors}
        client:load
      />
    </section>

    <section class="sl-grid">
      <article class="sl-section">
        <h2>City Senior Care Market Overview</h2>
        <p>{marketOverviewParagraph}</p>
        {cityData.richContent?.intro ? (
          <div set:html={cityData.richContent.intro}></div>
        ) : (
          <p>
            The local care landscape includes both single-service communities and multi-care campuses that serve different
            acuity levels over time. Families typically narrow options by first selecting care type, then comparing location,
            staffing model, and pricing structure at the facility level.
          </p>
        )}
      </article>
      <aside class="sl-section">
        <h2>Healthcare Systems Serving Seniors</h2>
        <ul class="sl-pill-list">
          {hospitals.length > 0 ? (
            hospitals.map((hospital) => (
              <li>
                <strong>{hospital.name}</strong>
                <div class="sl-muted">{hospital.type || 'Hospital'}{hospital.phone ? ` - ${hospital.phone}` : ''}</div>
              </li>
            ))
          ) : cityData.richContent?.hospitals?.length ? (
            cityData.richContent.hospitals.map((name) => (
              <li><strong>{name}</strong></li>
            ))
          ) : (
            <li>No hospital records matched this city key. Check statewide resources for nearby systems.</li>
          )}
        </ul>
      </aside>
    </section>

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>Types of Senior Living Available in {cityData.cityName}</h2>
      <p>
        Most families compare at least two care categories during decision-making. Assisted living usually focuses on daily
        support and medication management, memory care adds secure dementia-specific programming, and skilled nursing supports
        higher medical acuity with stronger clinical coverage. Independent living and residential care settings may offer lighter
        support with different pricing structures.
      </p>
      <div class="sl-badge-row">
        {activeCareTypes.map((care) => (
          <a class={`sl-badge ${care.badgeColorClass}`} href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${care.slug}/`}>
            {care.label} ({cityData.careTypeCounts[care.slug].toLocaleString()})
          </a>
        ))}
      </div>
    </section>

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>Cost of Senior Living in {cityData.cityName}</h2>
      <p>
        Assisted living in {cityData.cityName} often starts in the {formatCurrency(assistedCost.low)} to {formatCurrency(assistedCost.high)}
        range, while memory care commonly runs from {formatCurrency(memoryCost.low)} to {formatCurrency(memoryCost.high)} and nursing home
        care may exceed {formatCurrency(nursingCost.low)} monthly in higher-acuity scenarios. These ranges are directional and should be used
        for planning, not as final quotes.
      </p>
      <p>
        For accurate comparison, request written pricing that separates room and board from care-service charges, medication programs,
        and one-time move-in fees. Communities with similar headline pricing can produce very different all-in monthly cost after add-ons.
      </p>
    </section>

    <section class="sl-regulatory">
      <h2>State Regulatory and Assistance Context</h2>
      <p>
        Facilities in {cityData.cityName} operate under the oversight framework of {cityData.stateName}. SilverTech connects local
        listings to regulator and ombudsman channels so families can validate compliance context and escalate concerns when needed.
      </p>
      <div class="sl-reg-cards">
        <article class="sl-reg-card">
          <h3>Licensing Authority</h3>
          <p>{regulatory.licensing?.agencyName || 'State licensing authority reference'}</p>
          {regulatory.licensing?.websiteUrl && <a href={regulatory.licensing.websiteUrl} target="_blank" rel="noopener noreferrer nofollow">Visit Agency</a>}
        </article>
        <article class="sl-reg-card">
          <h3>Complaint Intake</h3>
          <p>{regulatory.licensing?.phone || 'Use state complaint channels'}</p>
          {regulatory.licensing?.complaintIntakeUrl && <a href={regulatory.licensing.complaintIntakeUrl} target="_blank" rel="noopener noreferrer nofollow">File Complaint</a>}
        </article>
        <article class="sl-reg-card">
          <h3>Medicaid Waiver</h3>
          <p>{regulatory.medicaid?.programName || 'Waiver details vary by state'}</p>
          {regulatory.medicaid?.website && <a href={regulatory.medicaid.website} target="_blank" rel="noopener noreferrer nofollow">View Program</a>}
        </article>
        <article class="sl-reg-card">
          <h3>Ombudsman</h3>
          <p>{regulatory.ombudsman?.programName || 'Long-term care ombudsman contact'}</p>
          {regulatory.ombudsman?.website && <a href={regulatory.ombudsman.website} target="_blank" rel="noopener noreferrer nofollow">Open Ombudsman</a>}
        </article>
      </div>
    </section>

    <FeaturedCommunities
      stateAbbr={cityData.stateAbbr}
      cityName={cityData.cityName}
      client:load
    />

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>All Facility Records</h2>
      <ul class="sl-facility-list">
        {topFacilities.map((facility) => (
          <li class="sl-facility-item">
            <div class="sl-facility-top">
              <h3><a href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${facility.id}/`}>{facility.name}</a></h3>
              <span class="sl-muted">{facility.ownershipType || 'Ownership not listed'}</span>
            </div>
            <p class="sl-muted">{[facility.street, `${facility.city}, ${facility.state} ${facility.zip}`].filter(Boolean).join(', ')}</p>
            <div class="sl-badge-row">
              {facility.careTypes.map((careTypeSlug) => {
                const careType = getCareTypeBySlug(careTypeSlug);
                return careType ? (
                  <a class={`sl-badge ${careType.badgeColorClass}`} href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${careType.slug}/`}>
                    {careType.label}
                  </a>
                ) : null;
              })}
            </div>
            <div class="sl-facility-actions">
              <a href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${facility.id}/`}>View Profile</a>
              {facility.googleMapsUrl ? (
                <a href={facility.googleMapsUrl} target="_blank" rel="noopener noreferrer nofollow">Map</a>
              ) : null}
              {facility.websiteUrl ? (
                <a href={facility.websiteUrl} target="_blank" rel="noopener noreferrer nofollow">Website</a>
              ) : null}
              {facility.phone || facility.verifiedPhone ? <span>{facility.verifiedPhone || facility.phone}</span> : null}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="sl-grid">
      <article class="sl-section">
        <h2>How Families Choose Care in {cityData.cityName}</h2>
        <p>
          Families evaluating senior living in {cityData.cityName} usually compare communities by three factors first:
          proximity to hospitals, presence of memory-care or skilled-nursing options, and total monthly affordability after
          all fees. Neighborhood differences can materially affect both cost structure and care model, so comparing across
          multiple ZIP clusters is usually more effective than selecting only one facility category.
        </p>
        <p>
          Multi-care campuses can be useful when long-term progression is a concern, while single-focus facilities may offer
          more specialized programs for one condition. The best fit usually comes from matching clinical need, family travel
          patterns, and contract clarity rather than selecting on marketing presentation alone.
        </p>
      </article>
      <aside class="sl-section">
        <h2>City Data Snapshot</h2>
        <div class="sl-data-grid">
          <div class="cell">
            <div class="k">Total Facilities</div>
            <div class="v">{cityData.stats.totalFacilities.toLocaleString()}</div>
          </div>
          <div class="cell">
            <div class="k">Phone Coverage</div>
            <div class="v">{cityData.stats.phoneCoveragePct}%</div>
          </div>
          <div class="cell">
            <div class="k">Website Coverage</div>
            <div class="v">{cityData.stats.websiteCoveragePct}%</div>
          </div>
          <div class="cell">
            <div class="k">Dominant Care</div>
            <div class="v">{getCareTypeLabel(cityData.stats.dominantCareType)}</div>
          </div>
          <div class="cell">
            <div class="k">Top ZIPs</div>
            <div class="v">{cityData.topZips.join(', ') || 'N/A'}</div>
          </div>
          <div class="cell">
            <div class="k">Medicare Share</div>
            <div class="v">{cityData.stats.medicareCertifiedPct}%</div>
          </div>
        </div>
      </aside>
    </section>

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>Frequently Asked Questions</h2>
      <div class="sl-faq">
        {faqItems.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>Explore Senior Living Near {cityData.cityName}</h2>
      <div class="sl-nearby-grid">
        {cityData.nearbyCities.map((nearby) => (
          <a href={`/senior-living/${nearby.stateSlug}/${nearby.citySlug}/`}>
            <strong>{nearby.cityName}</strong>
            <span>{nearby.facilityCount.toLocaleString()} facilities{nearby.distanceMiles !== null ? ` - ${nearby.distanceMiles} mi` : ''}</span>
          </a>
        ))}
      </div>
    </section>

    <footer class="sl-trust-footer">
      <span><strong>Author:</strong> SilverTech Editorial Team</span>
      <span><strong>Last Updated:</strong> {buildDateLabel}</span>
      <span><strong>Data Source:</strong> Public licensing datasets + SilverTech normalization pipeline</span>
      <span><a href="/editorial-policy/">Editorial Policy</a></span>
    </footer>
  </div>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Base>
