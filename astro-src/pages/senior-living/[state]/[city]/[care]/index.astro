---
import Base from '../../../../../layouts/Base.astro';
import MapIsland from '../../../../../components/senior/MapIsland';
import FeaturedCommunities from '../../../../../components/senior/FeaturedCommunities';
import { ALL_STATES } from '../../../../../../src/data/states';
import {
  getAllCityCareCombos,
  getFacilitiesByCity,
  getFacilitiesByCityAndCareType,
  getCityStats,
  getNearbyCities,
} from '../../../../../lib/seniorDataContract';
import {
  getSeniorLivingCity,
  getCityFacilitiesByCareType,
  getCityMapPoints,
  getCareTypes,
  getCareTypeBySlug,
  getCareTypeLabel,
  getRegulatoryContext,
  getHospitalsForCity,
  getBuildDate,
  formatDateLong,
  getCostBand,
  formatCurrency,
} from '../../../../../lib/seniorLivingData';

export async function getStaticPaths() {
  const enableStaticSeniorLiving =
    process.env.ENABLE_STATIC_SENIOR_LIVING === '1' ||
    process.env.ENABLE_STATIC_SENIOR_LIVING === 'true';
  if (!enableStaticSeniorLiving) return [];
  const combos = await getAllCityCareCombos();
  return combos.map(({ state, city, careTypeSlug }) => ({
    params: { state, city, care: careTypeSlug },
  }));
}

const { state: stateSlug, city: citySlug, care: careSlug } = Astro.params;
const careType = careSlug ? getCareTypeBySlug(careSlug) : null;

const toTitleCase = (value: string) =>
  value
    .split('-')
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');

const stateMetaBySlug = new Map(ALL_STATES.map((state) => [state.slug, state]));
const stateMeta =
  stateSlug
    ? stateMetaBySlug.get(stateSlug) ||
      ALL_STATES.find((state) => state.abbreviation.toLowerCase() === stateSlug.toLowerCase()) ||
      null
    : null;

const buildFallbackCityData = async () => {
  if (!stateSlug || !citySlug) return null;

  const normalizedFacilities = await getFacilitiesByCity(stateSlug, citySlug);
  if (normalizedFacilities.length === 0) return null;

  const cityStats = await getCityStats(stateSlug, citySlug);
  const nearby = await getNearbyCities(stateSlug, citySlug);
  const cityName = normalizedFacilities[0]?.city || toTitleCase(citySlug);
  const geoFacilities = normalizedFacilities.filter(
    (facility) => facility.latitude !== null && facility.longitude !== null,
  );
  const center =
    geoFacilities.length > 0
      ? {
          lat: geoFacilities.reduce((sum, facility) => sum + (facility.latitude || 0), 0) / geoFacilities.length,
          lng: geoFacilities.reduce((sum, facility) => sum + (facility.longitude || 0), 0) / geoFacilities.length,
        }
      : null;

  return {
    stateSlug: stateMeta?.slug || stateSlug,
    citySlug: citySlug,
    stateAbbr: stateMeta?.abbreviation || stateSlug.toUpperCase(),
    stateName: stateMeta?.name || (stateSlug.length === 2 ? stateSlug.toUpperCase() : toTitleCase(stateSlug)),
    cityName,
    careTypeCounts: cityStats.careTypeCounts,
    center,
    nearbyCities: nearby.map((item) => ({
      stateSlug: item.state,
      citySlug: item.slug,
      cityName: toTitleCase(item.slug),
      facilityCount: item.facilityCount,
      distanceMiles: item.distanceMiles === 9999 ? null : item.distanceMiles,
    })),
  };
};

let cityData = stateSlug && citySlug ? getSeniorLivingCity(stateSlug, citySlug) : null;
if (!cityData) {
  cityData = await buildFallbackCityData();
}

if (!cityData || !careType) {
  throw new Error(`Care page not found for ${stateSlug || 'unknown'}/${citySlug || 'unknown'}/${careSlug || 'unknown'}`);
}

let facilities = getCityFacilitiesByCareType(cityData.stateSlug, cityData.citySlug, careType.slug);
if (facilities.length === 0 && stateSlug && citySlug) {
  const normalizedFacilities = await getFacilitiesByCityAndCareType(stateSlug, citySlug, careType.slug);
  facilities = normalizedFacilities.map((facility) => ({
    id: facility.id,
    name: facility.name,
    city: facility.city,
    state: facility.state,
    street: facility.address,
    zip: facility.postalCode,
    phone: facility.phone,
    verifiedPhone: null,
    websiteUrl: facility.websiteUrl,
    googleMapsUrl: null,
    careTypes: facility.careTypes,
    ownershipType: facility.ownershipType,
    ownershipBucket:
      facility.ownershipType === 'for-profit'
        ? 'for_profit'
        : facility.ownershipType === 'nonprofit'
          ? 'non_profit'
          : facility.ownershipType === 'government'
            ? 'government'
            : 'unknown',
    listingTier: facility.listingTier,
    licenseNumber: facility.licenseNumber,
    cmsCertificationNumber: null,
    medicareCertified: facility.medicareCertified,
  }));
}
if (facilities.length === 0) {
  throw new Error(`No facilities available for ${careType.slug} in ${cityData.stateSlug}/${cityData.citySlug}`);
}

const buildDate = getBuildDate();
const buildDateLabel = formatDateLong(buildDate);
const title = `${careType.label} in ${cityData.cityName}, ${cityData.stateName}`;
const description = `${careType.label} directory page for ${cityData.cityName}, ${cityData.stateName} with local map, regulatory context, hospital references, facility records, and FAQ guidance.`;
const canonical = `https://silvertechdirectory.com/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${careType.slug}/`;

const hospitals = getHospitalsForCity(cityData.stateAbbr, cityData.cityName, 3);
const primaryHospital = hospitals[0] || null;
const regulatory = getRegulatoryContext(cityData.stateSlug);
const activeCareTypes = getCareTypes().filter((care) => cityData.careTypeCounts[care.slug] > 0);
const mapPoints = getCityMapPoints(cityData.stateSlug, cityData.citySlug, careType.slug);
const hospitalMapPoints = hospitals
  .map((hospital, index) => ({
    id: `${cityData.stateSlug}-${cityData.citySlug}-${index}-${hospital.name}`,
    name: hospital.name,
    lat: Number(hospital.latitude),
    lng: Number(hospital.longitude),
    address: [hospital.address, `${hospital.city || cityData.cityName}, ${hospital.state || cityData.stateAbbr} ${hospital.zip || ''}`]
      .filter(Boolean)
      .join(', '),
    type: hospital.type || 'Hospital',
  }))
  .filter((hospital) => Number.isFinite(hospital.lat) && Number.isFinite(hospital.lng));
const careColors = Object.fromEntries(getCareTypes().map((care) => [care.slug, care.mapColor]));
const costBand = getCostBand(careType.slug);
const visibleFacilities = facilities.slice(0, 30);
const isFacilityMedicareCertified = (facility: { cmsCertificationNumber?: string | null; medicareCertified?: boolean | null }) =>
  Boolean(facility.medicareCertified || facility.cmsCertificationNumber);
const medicareCertifiedPct = Math.round(
  (facilities.filter((item) => isFacilityMedicareCertified(item)).length / facilities.length) * 100,
);
const nearbyCareCitiesRaw =
  stateSlug && citySlug ? await getNearbyCities(stateSlug, citySlug, careType.slug) : [];
const nearbyCareCities = nearbyCareCitiesRaw.map((nearby) => ({
  stateSlug: nearby.state,
  citySlug: nearby.slug,
  cityName: toTitleCase(nearby.slug),
  facilityCount: nearby.facilityCount,
  distanceMiles: nearby.distanceMiles === 9999 ? null : nearby.distanceMiles,
}));

const careSpecificNarrative: Record<string, string> = {
  'assisted-living': `Assisted living in ${cityData.cityName} generally serves residents who need support with daily activities while maintaining as much independence as possible. Families typically compare medication management policies, staffing schedules, and level-of-care pricing structures across communities before deciding.`,
  'memory-care': `Memory care communities in ${cityData.cityName} are built for residents with dementia and related cognitive conditions. Compared with general assisted living, these settings usually include secure layouts, dementia-specific staff training, and structured routines intended to reduce distress and improve safety.`,
  'nursing-homes': `Nursing homes and skilled nursing facilities in ${cityData.cityName} generally support higher-acuity residents who need routine clinical oversight, rehabilitation, or long-term nursing support. Families often focus on staffing profile, care transitions, and proximity to hospitals when comparing options.`,
  'independent-living': `Independent living communities in ${cityData.cityName} primarily serve older adults who do not require intensive daily care but want a maintenance-free lifestyle and age-friendly amenities. Many families still compare care escalation pathways in case health needs increase later.`,
  'residential-care': `Residential care homes in ${cityData.cityName} tend to offer smaller-setting support with a more home-style environment. Families evaluating these communities often compare caregiver-to-resident ratio, overnight staffing, and communication responsiveness.`,
  'adult-day-services': `Adult day services in ${cityData.cityName} can help families keep loved ones at home while receiving structured daytime support. Key evaluation points include program schedule, clinical support levels, transportation availability, and caregiver respite impact.`,
  ccrc: `CCRC and life plan communities in ${cityData.cityName} combine multiple care levels in one campus model, from independent living through higher-acuity support. Families often evaluate contract structure and long-term care transition options before move-in.`,
};

const faqItems = [
  {
    question: `How many ${careType.shortLabel.toLowerCase()} facilities are indexed in ${cityData.cityName}?`,
    answer: `SilverTech currently indexes ${facilities.length.toLocaleString()} ${careType.label.toLowerCase()} records in ${cityData.cityName}. Some of these communities are dedicated to one care model, while others also provide additional services such as assisted living or skilled nursing. The directory shows those overlaps with care badges so families and analysts can quickly identify whether a listing is single-service or part of a broader multi-care campus.`,
  },
  {
    question: `What is the typical monthly cost range for ${careType.label.toLowerCase()} in ${cityData.cityName}?`,
    answer: `A planning range for ${careType.label.toLowerCase()} in ${cityData.cityName} is often around ${formatCurrency(costBand.low)} to ${formatCurrency(costBand.high)} per month, but final pricing depends on care intensity, staffing requirements, unit type, and contract terms. Always request written itemized pricing and compare at least three facilities. Separating room-and-board from care-service fees helps avoid underestimating the true monthly budget.`,
  },
  {
    question: `Does ${cityData.stateName} Medicaid help cover ${careType.shortLabel.toLowerCase()} in ${cityData.cityName}?`,
    answer: `Coverage depends on the ${cityData.stateName} Medicaid structure and waiver eligibility rules. ${regulatory.medicaid?.programName || 'State Medicaid waiver pathways'} can support parts of long-term care services, but room-and-board and service mix rules vary by program and facility. Families should verify both the facility's Medicaid acceptance policy and current state eligibility guidance before finalizing budget assumptions.`,
  },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://silvertechdirectory.com/' },
    { '@type': 'ListItem', position: 2, name: 'Senior Care', item: 'https://silvertechdirectory.com/senior-living/' },
    { '@type': 'ListItem', position: 3, name: cityData.stateName, item: `https://silvertechdirectory.com/senior-living/${cityData.stateSlug}/` },
    { '@type': 'ListItem', position: 4, name: cityData.cityName, item: `https://silvertechdirectory.com/senior-living/${cityData.stateSlug}/${cityData.citySlug}/` },
    { '@type': 'ListItem', position: 5, name: careType.label, item: canonical },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: visibleFacilities.map((facility, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'MedicalBusiness',
      name: facility.name,
      url: `https://silvertechdirectory.com/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${facility.id}/`,
      telephone: facility.verifiedPhone || facility.phone || undefined,
      identifier: facility.licenseNumber
        ? {
            '@type': 'PropertyValue',
            propertyID: 'state_license_number',
            value: facility.licenseNumber,
          }
        : undefined,
      address: {
        '@type': 'PostalAddress',
        streetAddress: facility.street || '',
        addressLocality: facility.city,
        addressRegion: facility.state,
        postalCode: facility.zip || '',
        addressCountry: 'US',
      },
    },
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---
<Base title={title} description={description} canonical={canonical}>
  <link slot="head" rel="stylesheet" href="/styles/senior-living.css" />

  <div class="container sl-page">
    <nav class="sl-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href={`/senior-living/${cityData.stateSlug}/`}>{cityData.stateName}</a>
      <span>/</span>
      <a href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/`}>{cityData.cityName}</a>
      <span>/</span>
      <span>{careType.label}</span>
    </nav>

    <section class="sl-hero">
      <p class="sl-eyebrow">City Care-Type Hub</p>
      <h1>{careType.label} in {cityData.cityName}, {cityData.stateName}</h1>
      <p>
        This page focuses on {careType.label.toLowerCase()} providers in {cityData.cityName}. Facility cards may also show
        additional care badges when a community supports more than one service type.
      </p>
      <div class="sl-hero-meta">
        <span><strong>{facilities.length.toLocaleString()}</strong> facilities in this category</span>
        <span><strong>{medicareCertifiedPct}%</strong> Medicare-certified</span>
        <span><strong>{primaryHospital?.name || 'Hospital coverage by city'}</strong></span>
      </div>
      <div class="sl-hero-actions">
        <a class="sl-btn sl-btn-primary" href={`/search?state=${encodeURIComponent(cityData.stateAbbr)}&city=${encodeURIComponent(cityData.cityName)}&care=${encodeURIComponent(careType.label)}`}>Browse Facilities</a>
        <a class="sl-btn sl-btn-secondary" href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/`}>View All Care Types</a>
      </div>
    </section>

    <section class="sl-stats-grid">
      <article class="sl-stat">
        <p class="k">Total Properties</p>
        <p class="v">{facilities.length.toLocaleString()}</p>
        <p class="s">{careType.label} inventory in this city</p>
      </article>
      <article class="sl-stat">
        <p class="k">Phone Coverage</p>
        <p class="v">{Math.round((facilities.filter((item) => item.phone || item.verifiedPhone).length / facilities.length) * 100)}%</p>
        <p class="s">Listings with callable contact</p>
      </article>
      <article class="sl-stat">
        <p class="k">Ownership Split</p>
        <p class="v" style="font-size:1.05rem">{Math.round((facilities.filter((item) => item.ownershipBucket === 'for_profit').length / facilities.length) * 100)}% For-Profit</p>
        <p class="s">{Math.round((facilities.filter((item) => item.ownershipBucket === 'non_profit').length / facilities.length) * 100)}% Non-Profit</p>
      </article>
      <article class="sl-stat">
        <p class="k">Nearest Hospital</p>
        <p class="v" style="font-size:1.05rem">{primaryHospital?.name || 'Regional referral network'}</p>
        <p class="s">{primaryHospital?.type || 'Hospital system context'}</p>
      </article>
    </section>

    <nav class="sl-care-tabs" aria-label="Care type filters">
      {activeCareTypes.map((care) => (
        <a
          class={care.slug === careType.slug ? 'active' : ''}
          href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${care.slug}/`}
        >
          {care.label} ({cityData.careTypeCounts[care.slug].toLocaleString()})
        </a>
      ))}
    </nav>

    <section style="margin-top:1rem;">
      <MapIsland
        points={mapPoints}
        hospitals={hospitalMapPoints}
        fallbackCenter={cityData.center || { lat: 39.8283, lng: -98.5795 }}
        careColors={careColors}
        client:load
      />
    </section>

    <section class="sl-regulatory">
      <h2>{cityData.stateName} Regulatory Compliance Context</h2>
      <p>
        {careSpecificNarrative[careType.slug]}
      </p>
      <div class="sl-reg-cards">
        <article class="sl-reg-card">
          <h3>Licensing Authority</h3>
          <p>{regulatory.licensing?.agencyName || 'State licensing authority reference'}</p>
          {regulatory.licensing?.websiteUrl && <a href={regulatory.licensing.websiteUrl} target="_blank" rel="noopener noreferrer nofollow">View Mandates</a>}
        </article>
        <article class="sl-reg-card">
          <h3>Complaint Intake</h3>
          <p>{regulatory.licensing?.phone || 'State complaint channels listed by authority'}</p>
          {regulatory.licensing?.complaintIntakeUrl && <a href={regulatory.licensing.complaintIntakeUrl} target="_blank" rel="noopener noreferrer nofollow">Report Concern</a>}
        </article>
        <article class="sl-reg-card">
          <h3>Medicaid Program</h3>
          <p>{regulatory.medicaid?.programName || 'Waiver coverage details vary by state'}</p>
          {regulatory.medicaid?.website && <a href={regulatory.medicaid.website} target="_blank" rel="noopener noreferrer nofollow">Review Program</a>}
        </article>
        <article class="sl-reg-card">
          <h3>Ombudsman Support</h3>
          <p>{regulatory.ombudsman?.programName || 'Long-term care ombudsman support'}</p>
          {regulatory.ombudsman?.website && <a href={regulatory.ombudsman.website} target="_blank" rel="noopener noreferrer nofollow">Open Ombudsman</a>}
        </article>
      </div>
    </section>

    <FeaturedCommunities
      stateAbbr={cityData.stateAbbr}
      cityName={cityData.cityName}
      careType={careType.slug}
      client:load
    />

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>All {careType.label} Facility Records</h2>
      <ul class="sl-facility-list">
        {visibleFacilities.map((facility) => (
          <li class="sl-facility-item">
            <div class="sl-facility-top">
              <h3><a href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${facility.id}/`}>{facility.name}</a></h3>
              <span class="sl-muted">{facility.ownershipType || 'Ownership not listed'}</span>
            </div>
            <p class="sl-muted">{[facility.street, `${facility.city}, ${facility.state} ${facility.zip}`].filter(Boolean).join(', ')}</p>
            <p class="sl-muted">
              License: {facility.licenseNumber || 'Pending'} • Medicare: {isFacilityMedicareCertified(facility) ? 'Certified' : 'Not listed'}
            </p>
            <div class="sl-badge-row">
              {facility.careTypes.map((careSlugItem) => {
                const care = getCareTypeBySlug(careSlugItem);
                return care ? (
                  <a class={`sl-badge ${care.badgeColorClass}`} href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${care.slug}/`}>
                    {care.label}
                  </a>
                ) : null;
              })}
            </div>
            <div class="sl-facility-actions">
              <a href={`/senior-living/${cityData.stateSlug}/${cityData.citySlug}/${facility.id}/`}>View Profile</a>
              {facility.googleMapsUrl ? (
                <a href={facility.googleMapsUrl} target="_blank" rel="noopener noreferrer nofollow">Map</a>
              ) : null}
              {facility.websiteUrl ? (
                <a href={facility.websiteUrl} target="_blank" rel="noopener noreferrer nofollow">Website</a>
              ) : null}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>Understanding {cityData.stateName} {careType.label} Regulations</h2>
      <p>
        {careType.label} facilities in {cityData.cityName} are expected to operate within the state licensing framework and
        maintain documented policies for resident safety, admissions criteria, and complaint response pathways. Families can
        use this care-type page to shortlist providers, then validate questions about staffing ratios, care plans, and resident
        rights through official state resources.
      </p>
      <p>
        For budget planning, {formatCurrency(costBand.low)} to {formatCurrency(costBand.high)} is a useful directional range
        for this care type in many markets, but final cost still depends on acuity and contract terms. Compare itemized pricing
        before selecting a community.
      </p>
    </section>

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>Frequently Asked Questions</h2>
      <div class="sl-faq">
        {faqItems.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="sl-section" style="margin-top:0.9rem;">
      <h2>Explore {careType.label} in Nearby Cities</h2>
      <div class="sl-nearby-grid">
        {nearbyCareCities.length > 0 ? nearbyCareCities.map((nearby) => (
          <a href={`/senior-living/${nearby.stateSlug}/${nearby.citySlug}/${careType.slug}/`}>
            <strong>{nearby.cityName}</strong>
            <span>{nearby.facilityCount.toLocaleString()} facilities{nearby.distanceMiles !== null ? ` - ${nearby.distanceMiles} mi` : ''}</span>
          </a>
        )) : <p class="sl-muted">No nearby city pages currently have this care type indexed.</p>}
      </div>
    </section>

    <footer class="sl-trust-footer">
      <span><strong>Author:</strong> SilverTech Editorial Team</span>
      <span><strong>Last Updated:</strong> {buildDateLabel}</span>
      <span><strong>Data Source:</strong> Public licensing datasets + SilverTech normalization pipeline</span>
      <span><a href="/editorial-policy/">Editorial Policy</a></span>
    </footer>
  </div>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Base>
