---
import Base from '../../layouts/Base.astro';
import { getFacilityIndex, getStateName, getStateSlug, toCitySlug } from '../../lib/data';

export async function getStaticPaths() {
  const facilities = getFacilityIndex();
  return facilities.map((f) => ({
    params: { id: String(f.id) },
    props: f
  }));
}

const facility = Astro.props;
const stateName = getStateName(facility.state || '');

const title = `${facility.name} | Assisted Living in ${facility.city}, ${facility.state}`;
const description = `Learn about ${facility.name}, a senior living community in ${facility.city}, ${stateName}. View address, contact details, and verified data.`;
const canonical = `https://silvertechdirectory.com/facility/${facility.id}/`;
const schema = {
  "@context": "https://schema.org",
  "@type": "SeniorLivingCommunity",
  "name": facility.name,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": facility.address_line1 || '',
    "addressLocality": facility.city || '',
    "addressRegion": facility.state || '',
    "postalCode": facility.postal_code || '',
    "addressCountry": "US"
  },
  "telephone": facility.phone || undefined,
  "url": canonical
};
const stateSlug = getStateSlug(facility.state || '');
const citySlug = toCitySlug(facility.city || '');
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://silvertechdirectory.com/" },
    { "@type": "ListItem", "position": 2, "name": "Assisted Living", "item": "https://silvertechdirectory.com/assisted-living" },
    { "@type": "ListItem", "position": 3, "name": stateName, "item": `https://silvertechdirectory.com/assisted-living/${stateSlug}/` },
    { "@type": "ListItem", "position": 4, "name": facility.city, "item": `https://silvertechdirectory.com/assisted-living/${stateSlug}/cities/${citySlug}/` },
    { "@type": "ListItem", "position": 5, "name": facility.name, "item": canonical }
  ]
};
const facilityDescriptor = `${facility.facility_type || ''} ${facility.name || ''}`.toLowerCase();
const isMemoryCareTagged = /memory|dementia|alzheimer/.test(facilityDescriptor);
const supportiveGuide = {
  href: '/guides/guilt-about-placing-parent-in-memory-care/',
  label: 'Guilt About Placing a Parent in Memory Care'
};
const stateDirectoryHref = `/assisted-living/${stateSlug}/`;
const cityDirectoryHref = `/assisted-living/${stateSlug}/cities/${citySlug}/`;
---
<Base title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <section class="container facility-shell">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href={stateDirectoryHref}>{stateName}</a>
      <span>/</span>
      <a href={cityDirectoryHref}>{facility.city}</a>
      <span>/</span>
      <span>{facility.name}</span>
    </nav>

    <div class="hero">
      <p class="kicker">Verified Listing</p>
      <h1>{facility.name}</h1>
      <p class="subhead">Assisted Living in {facility.city}, {facility.state}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={cityDirectoryHref}>Browse {facility.city} Directory</a>
        <a class="btn btn-ghost" href={stateDirectoryHref}>Explore {stateName}</a>
      </div>
    </div>

    <div class="meta">
      <div><strong>Author:</strong> SilverTech Editorial Team</div>
      <div><strong>Last updated:</strong> February 8, 2026</div>
    </div>
    <div class="note note-gap">
      <strong>Data source:</strong> Facility details are compiled from public records and official state licensing authorities.
      Learn more in our <a href="/editorial-policy" style="color:#2563eb; text-decoration: underline;">Editorial Policy</a>.
    </div>

    <div class="card info-card">
      <div class="list-item">
        <strong>Address</strong>
        <span class="muted">
          {facility.address_line1 || 'Address unavailable'}{facility.address_line1 ? ',' : ''} {facility.city}, {facility.state} {facility.postal_code || ''}
        </span>
      </div>
      <div class="list-item info-gap">
        <strong>Phone</strong>
        <span class="muted">{facility.phone || 'Phone unavailable'}</span>
      </div>
      {isMemoryCareTagged && (
        <p class="muted memory-note">
          Families navigating difficult memory care decisions may find this helpful:
          <a href={supportiveGuide.href} class="memory-link">
            {supportiveGuide.label}
          </a>
        </p>
      )}
    </div>
  </section>

  <style>
    .facility-shell {
      padding-top: 1.5rem;
      padding-bottom: 2.5rem;
    }
    .crumbs {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem;
      color: #64748b;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
    .crumbs a:hover {
      color: #0f172a;
      text-decoration: underline;
    }
    .hero {
      background: linear-gradient(135deg, #111827 0%, #1f2937 45%, #374151 100%);
      color: #fff;
      border-radius: 16px;
      padding: 1.4rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      margin-bottom: 1rem;
    }
    .kicker {
      font-size: 0.74rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 700;
      color: #facc15;
      margin: 0;
    }
    h1 {
      margin: 0.35rem 0 0;
      font-size: clamp(1.8rem, 3vw, 2.35rem);
      line-height: 1.05;
    }
    .subhead {
      margin: 0.65rem 0 0;
      color: #e5e7eb;
      font-size: 1.05rem;
    }
    .hero-actions {
      margin-top: 1rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.58rem 0.9rem;
      border-radius: 9px;
      font-weight: 700;
      font-size: 0.9rem;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }
    .btn-primary {
      background: #eab308;
      color: #111827;
    }
    .btn-primary:hover {
      background: #facc15;
    }
    .btn-ghost {
      border-color: rgba(255, 255, 255, 0.4);
      color: #fff;
      background: rgba(255, 255, 255, 0.04);
    }
    .btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
    }
    .note-gap {
      margin-top: 0.75rem;
    }
    .info-card {
      margin-top: 1rem;
    }
    .info-gap {
      margin-top: 1rem;
    }
    .memory-note {
      margin: 1rem 0 0;
      font-size: 0.92rem;
    }
    .memory-link {
      color: #ca8a04;
      font-weight: 700;
      text-decoration: underline;
      margin-left: 0.35rem;
    }
  </style>
</Base>
