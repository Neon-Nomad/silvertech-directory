---
import Base from '../../layouts/Base.astro';
import { getFacilityIndex, getStateName, getStateSlug, toCitySlug } from '../../lib/data';

export async function getStaticPaths() {
  const facilities = getFacilityIndex();
  return facilities.map((f) => ({
    params: { id: String(f.id) },
    props: f
  }));
}

const facility = Astro.props;
const stateName = getStateName(facility.state || '');
const stateSlug = getStateSlug(facility.state || '');
const citySlug = toCitySlug(facility.city || '');
const encodedFacilityId = encodeURIComponent(String(facility.id || '').trim());

const title = `${facility.name} | Senior Living in ${facility.city}, ${facility.state}`;
const description = `Learn about ${facility.name}, a senior living community in ${facility.city}, ${stateName}. View address, contact details, and verified data.`;
const canonical = `https://silvertechdirectory.com/senior-living/${stateSlug}/${citySlug}/${encodedFacilityId}/`;
const facilityKeywordTargets = [
  `${facility.name} assisted living`,
  `${facility.name} ${facility.city} ${facility.state}`,
  `assisted living in ${facility.city}, ${facility.state}`,
  `senior care in ${facility.city}, ${facility.state}`,
  `memory care near ${facility.city}, ${facility.state}`
];
const keywords = facilityKeywordTargets.join(', ');
const schema = {
  "@context": "https://schema.org",
  "@type": "SeniorLivingCommunity",
  "name": facility.name,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": facility.address_line1 || '',
    "addressLocality": facility.city || '',
    "addressRegion": facility.state || '',
    "postalCode": facility.postal_code || '',
    "addressCountry": "US"
  },
  "telephone": facility.phone || undefined,
  "url": canonical
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://silvertechdirectory.com/" },
    { "@type": "ListItem", "position": 2, "name": "Senior Living", "item": "https://silvertechdirectory.com/senior-living/" },
    { "@type": "ListItem", "position": 3, "name": stateName, "item": `https://silvertechdirectory.com/senior-living/${stateSlug}/` },
    { "@type": "ListItem", "position": 4, "name": facility.city, "item": `https://silvertechdirectory.com/senior-living/${stateSlug}/${citySlug}/` },
    { "@type": "ListItem", "position": 5, "name": facility.name, "item": canonical }
  ]
};
const facilityDescriptor = `${facility.facility_type || ''} ${facility.name || ''}`.toLowerCase();
const isMemoryCareTagged = /memory|dementia|alzheimer/.test(facilityDescriptor);
const supportiveGuide = {
  href: '/guides/guilt-about-placing-parent-in-memory-care/',
  label: 'Guilt About Placing a Parent in Memory Care'
};
const primaryGuideLink = isMemoryCareTagged
  ? supportiveGuide
  : {
      href: '/guides/hidden-costs-of-memory-care/',
      label: 'Hidden Costs of Memory Care: What Families Are Never Told Up Front'
    };
const secondaryGuideLink = isMemoryCareTagged
  ? {
      href: '/guides/caregiver-at-breaking-point/',
      label: 'I Cannot Do This Anymore Caring for My Parent'
    }
  : {
      href: '/guides/guilt-about-placing-parent-in-memory-care/',
      label: 'Guilt About Placing a Parent in Memory Care'
    };
const stateDirectoryHref = `/senior-living/${stateSlug}/`;
const cityDirectoryHref = `/senior-living/${stateSlug}/${citySlug}/`;

const normalizeFacilityType = (value?: string) => {
  const raw = (value || '').trim().toLowerCase();
  if (!raw) return 'assisted living';
  return raw.replace(/[_-]+/g, ' ');
};
const facilityTypeText = normalizeFacilityType(facility.facility_type || facility.type);
const hasWebsite = Boolean(facility.website_url);
const hasPhone = Boolean(facility.phone);
const hasAddress = Boolean(facility.address_line1);
---
<Base title={title} description={description} canonical={canonical} liteHead={true} loadFonts={false}>
  <meta slot="head" name="keywords" content={keywords} />
  <link slot="head" rel="stylesheet" href="/styles/facility-page.css" />
  <section slot="pre-body" class="container crawl-priority-prelude" aria-label="Facility Data Signals">
    <h1 class="sr-only">{facility.name}</h1>
    <div class="crawl-priority-signals">
      <h2>Facility Data Signals</h2>
      <p class="signal-copy">
        Facility classification: {facilityTypeText}. Directory locality: {facility.city}, {facility.state}.
      </p>
      <ul class="signal-list">
        <li><strong>Verified phone:</strong> {hasPhone ? 'Available' : 'Not listed'}</li>
        <li><strong>Address record:</strong> {hasAddress ? 'Available' : 'Not listed'}</li>
        <li><strong>Website:</strong> {hasWebsite ? 'Available' : 'Not listed'}</li>
      </ul>
    </div>
  </section>
  <section class="container facility-shell">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href={stateDirectoryHref}>{stateName}</a>
      <span>/</span>
      <a href={cityDirectoryHref}>{facility.city}</a>
      <span>/</span>
      <span>{facility.name}</span>
    </nav>

    <div class="hero">
      <p class="kicker">Verified Listing</p>
      <p class="hero-title">{facility.name}</p>
      <p class="subhead">Senior Living in {facility.city}, {facility.state}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={cityDirectoryHref}>Browse {facility.city} Directory</a>
        <a class="btn btn-ghost" href={stateDirectoryHref}>Explore {stateName}</a>
      </div>
    </div>

    <div class="meta">
      <div><strong>Author:</strong> SilverTech Editorial Team</div>
      <div><strong>Last updated:</strong> February 8, 2026</div>
    </div>
    <div class="note note-gap">
      <strong>Data source:</strong> Facility details are compiled from public records and official state licensing authorities.
      Learn more in our <a href="/editorial-policy" style="color:#2563eb; text-decoration: underline;">Editorial Policy</a>.
    </div>

    <div class="card info-card">
      <div class="list-item">
        <strong>Address</strong>
        <span class="muted">
          {facility.address_line1 || 'Address unavailable'}{facility.address_line1 ? ',' : ''} {facility.city}, {facility.state} {facility.postal_code || ''}
        </span>
      </div>
      <div class="list-item info-gap">
        <strong>Phone</strong>
        <span class="muted">{facility.phone || 'Phone unavailable'}</span>
      </div>
      {isMemoryCareTagged && (
        <p class="muted memory-note">
          Families navigating difficult memory care decisions may find this helpful:
          <a href={supportiveGuide.href} class="memory-link">
            {supportiveGuide.label}
          </a>
        </p>
      )}
    </div>

    <div class="card prep-card">
      <h2>What to Confirm Before You Tour</h2>
      <ul>
        <li>Ask for a written pricing sheet with base rent and care-level add-ons.</li>
        <li>Confirm how medication management and after-hours staffing are handled.</li>
        <li>Request recent inspection context for {stateName} licensing compliance.</li>
        <li>Verify emergency transfer process and family notification standards.</li>
        <li>Compare this listing against nearby options in {facility.city} before signing.</li>
      </ul>
      <p class="muted">
        Use <a href={cityDirectoryHref}>city comparisons</a> and <a href={stateDirectoryHref}>{stateName} statewide data</a> to benchmark fit, not just first impressions.
      </p>
    </div>

    <div class="card link-mesh-card">
      <h2>Planning and Licensing Links</h2>
      <ul class="link-mesh-list">
        <li>
          <a href={stateDirectoryHref}>Understanding {stateName} licensing and oversight requirements</a>
        </li>
        <li>
          <a href={primaryGuideLink.href}>{primaryGuideLink.label}</a>
        </li>
        <li>
          <a href={secondaryGuideLink.href}>{secondaryGuideLink.label}</a>
        </li>
        <li>
          <a href={cityDirectoryHref}>Senior care in {facility.city}, {facility.state}</a>
        </li>
      </ul>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</Base>
