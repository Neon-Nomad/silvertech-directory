---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../../layouts/Base.astro';
import { ALL_STATES } from '../../../../src/data/states';

type RegulationPayload = {
  licensing_content?: string;
  complaints_content?: string;
  contacts_json?: {
    licensing?: { name?: string; phone?: string; website?: string };
    ombudsman?: { name?: string; phone?: string; website?: string };
  };
};

export async function getStaticPaths() {
  return ALL_STATES.map((state) => ({ params: { state: state.slug } }));
}

const { state: stateSlugParam } = Astro.params;
const stateMeta = ALL_STATES.find((state) => state.slug === (stateSlugParam || '').toLowerCase());
if (!stateMeta) {
  throw new Error(`State regulations page not found for slug: ${stateSlugParam || 'unknown'}`);
}

const regulationFileName = `${stateMeta.slug.replace(/-/g, '_')}.json`;
const regulationFilePath = path.resolve(process.cwd(), 'src', 'generated', 'regulations', regulationFileName);

let payload: RegulationPayload = {};
if (fs.existsSync(regulationFilePath)) {
  payload = JSON.parse(fs.readFileSync(regulationFilePath, 'utf-8')) as RegulationPayload;
}

const stripMarkdown = (input: string): string =>
  input
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/\[(.*?)\]\([^)]+\)/g, '$1')
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .replace(/\*(.*?)\*/g, '$1')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/\n{3,}/g, '\n\n')
    .trim();

const paragraphs = stripMarkdown(payload.licensing_content || payload.complaints_content || '')
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter((paragraph) => paragraph.length > 80)
  .slice(0, 8);

const title = `${stateMeta.name} Regulations | SilverTech Directory`;
const description = `Licensing, complaint, and oversight reference page for senior care facilities in ${stateMeta.name}.`;
const canonical = `https://silvertechdirectory.com/regulations/${stateMeta.slug}/`;
---
<Base title={title} description={description} canonical={canonical}>
  <link slot="head" rel="stylesheet" href="/styles/senior-living.css" />

  <div class="container sl-page">
    <nav class="sl-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/regulations/">Regulations</a>
      <span>/</span>
      <span>{stateMeta.name}</span>
    </nav>

    <section class="sl-hero">
      <p class="sl-eyebrow">State Regulatory Hub</p>
      <h1>{stateMeta.name} Regulations</h1>
      <p>
        Licensing, complaint, and oversight reference page for senior care facilities in {stateMeta.name}.
      </p>
      <div class="sl-hero-actions">
        <a class="sl-btn sl-btn-primary" href={`/assisted-living/${stateMeta.slug}/`}>View {stateMeta.name} Directory</a>
      </div>
    </section>

    <section class="sl-grid">
      <article class="sl-section">
        <h2>Regulatory Summary</h2>
        {paragraphs.length > 0 ? (
          paragraphs.map((paragraph) => <p>{paragraph}</p>)
        ) : (
          <p>
            Regulatory summary content is being refreshed for {stateMeta.name}. Use official licensing and ombudsman resources while that update completes.
          </p>
        )}
      </article>
      <aside class="sl-section">
        <h2>Official Contacts</h2>
        <ul class="sl-pill-list">
          <li>
            <strong>Licensing Authority</strong>
            <div class="sl-muted">{payload.contacts_json?.licensing?.name || 'State licensing office'}</div>
            {payload.contacts_json?.licensing?.phone ? <div class="sl-muted">{payload.contacts_json.licensing.phone}</div> : null}
            {payload.contacts_json?.licensing?.website ? (
              <a href={payload.contacts_json.licensing.website} target="_blank" rel="noopener noreferrer nofollow">Visit licensing website</a>
            ) : null}
          </li>
          <li>
            <strong>Long-Term Care Ombudsman</strong>
            <div class="sl-muted">{payload.contacts_json?.ombudsman?.name || 'State ombudsman program'}</div>
            {payload.contacts_json?.ombudsman?.phone ? <div class="sl-muted">{payload.contacts_json.ombudsman.phone}</div> : null}
            {payload.contacts_json?.ombudsman?.website ? (
              <a href={payload.contacts_json.ombudsman.website} target="_blank" rel="noopener noreferrer nofollow">Visit ombudsman website</a>
            ) : null}
          </li>
        </ul>
      </aside>
    </section>
  </div>
</Base>
