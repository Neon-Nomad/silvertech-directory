---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../../layouts/Base.astro';
import { getSeniorLivingState } from '../../../lib/seniorLivingData';
import { ALL_STATES } from '../../../../src/data/states';

type RegulationPayload = {
  licensing_content?: string;
  medicaid_content?: string;
  ombudsman_content?: string;
  complaints_content?: string;
  veterans_content?: string;
  contacts_json?: {
    licensing?: { name?: string; phone?: string; website?: string };
    ombudsman?: { name?: string; phone?: string; website?: string };
    medicaid?: { name?: string; phone?: string; website?: string };
    elderAbuse?: { name?: string; phone?: string; website?: string };
  };
};

type InsightSource = { label: string; url: string };
type InsightItem = { title: string; copy: string; sources: InsightSource[] };
type QuickFactItem = { heading: string; value: string; sourceUrl?: string };
type FamiliesMissItem = { title: string; copy: string };
type GraphLinkPosition = 'hero' | 'mid' | 'section' | 'footer';
type GraphLink = {
  href: string;
  label: string;
  event: 'reg_to_state' | 'reg_to_city';
  position: GraphLinkPosition;
  city: string | null;
};

export async function getStaticPaths() {
  return ALL_STATES.map((state) => ({ params: { state: state.slug } }));
}

const { state: stateSlugParam } = Astro.params;
const stateMeta = ALL_STATES.find((state) => state.slug === (stateSlugParam || '').toLowerCase());
if (!stateMeta) {
  throw new Error(`State regulations page not found for slug: ${stateSlugParam || 'unknown'}`);
}

const regulationFileName = `${stateMeta.slug.replace(/-/g, '_')}.json`;
const regulationFilePath = path.resolve(process.cwd(), 'src', 'generated', 'regulations', regulationFileName);

let payload: RegulationPayload = {};
if (fs.existsSync(regulationFilePath)) {
  payload = JSON.parse(fs.readFileSync(regulationFilePath, 'utf-8')) as RegulationPayload;
}

// Converts markdown to semantic HTML, preserving heading hierarchy, links,
// bold, lists, and blockquotes. Tables are converted to plain paragraphs.
const mdToHtml = (md: string): string => {
  if (!md) return '';

  const lines = md.split('\n');
  const out: string[] = [];
  let inList = false;
  let listType = '';

  const flushList = () => {
    if (inList) {
      out.push(`</${listType}>`);
      inList = false;
      listType = '';
    }
  };

  const escHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const inlineFormat = (s: string): string =>
    s
      .replace(/\*\*\*(.+?)\*\*\*/g, '<strong>$1</strong>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*\n]+?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(
        /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer nofollow">$1</a>',
      );

  for (let i = 0; i < lines.length; i++) {
    const raw = lines[i];
    const line = raw.trimEnd();

    // Skip table rows and separators
    if (/^\|.*\|/.test(line) || /^[-| :]+$/.test(line)) {
      flushList();
      continue;
    }

    // Headings — shift down one level since H1 is the page title
    const headingMatch = line.match(/^(#{1,6})\s+(.+)$/);
    if (headingMatch) {
      flushList();
      const depth = Math.min(headingMatch[1].length + 1, 5); // h1→h2, h2→h3, etc.
      const tag = `h${depth}`;
      out.push(`<${tag}>${inlineFormat(escHtml(headingMatch[2]))}</${tag}>`);
      continue;
    }

    // Blockquote
    const bqMatch = line.match(/^>\s*(.*)$/);
    if (bqMatch) {
      flushList();
      out.push(`<blockquote><p>${inlineFormat(escHtml(bqMatch[1]))}</p></blockquote>`);
      continue;
    }

    // Horizontal rule
    if (/^(\*{3,}|-{3,}|_{3,})$/.test(line.trim())) {
      flushList();
      out.push('<hr>');
      continue;
    }

    // Unordered list item
    const ulMatch = line.match(/^\s*[-*+]\s+(.+)$/);
    if (ulMatch) {
      if (!inList || listType !== 'ul') {
        flushList();
        out.push('<ul>');
        inList = true;
        listType = 'ul';
      }
      out.push(`<li>${inlineFormat(escHtml(ulMatch[1]))}</li>`);
      continue;
    }

    // Ordered list item
    const olMatch = line.match(/^\s*\d+\.\s+(.+)$/);
    if (olMatch) {
      if (!inList || listType !== 'ol') {
        flushList();
        out.push('<ol>');
        inList = true;
        listType = 'ol';
      }
      out.push(`<li>${inlineFormat(escHtml(olMatch[1]))}</li>`);
      continue;
    }

    // Blank line
    if (!line.trim()) {
      flushList();
      out.push('');
      continue;
    }

    // Regular paragraph line
    flushList();
    out.push(inlineFormat(escHtml(line)));
  }

  flushList();

  // Wrap consecutive non-tag lines into <p> blocks
  const result: string[] = [];
  let pBuf: string[] = [];

  const flushP = () => {
    if (pBuf.length) {
      result.push(`<p>${pBuf.join(' ')}</p>`);
      pBuf = [];
    }
  };

  for (const line of out) {
    if (!line) {
      flushP();
      continue;
    }
    if (/^<(h[2-5]|ul|ol|li|blockquote|hr|\/ul|\/ol)/.test(line)) {
      flushP();
      result.push(line);
    } else {
      pBuf.push(line);
    }
  }
  flushP();

  return result.join('\n');
};

const normalizeText = (value: string): string => value.replace(/\s+/g, ' ').trim();
const stripFormatting = (value: string): string => value.replace(/[*_`~[\]()]/g, ' ');

const markdownToPlainText = (md: string): string =>
  normalizeText(
    md
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/`[^`]*`/g, ' ')
      .replace(/!\[[^\]]*]\([^)]*\)/g, ' ')
      .replace(/\[[^\]]*]\(([^)]*)\)/g, ' $1 ')
      .replace(/[#>*_~|]/g, ' ')
      .replace(/-{3,}/g, ' ')
      .replace(/\n/g, ' '),
  );

const cleanUrl = (url: string): string => url.replace(/[\])},.;:]+$/g, '');

const extractUrls = (md: string, limit = 4): string[] => {
  const matches = md.match(/https?:\/\/[^\s)]+/g) || [];
  const unique: string[] = [];
  for (const raw of matches) {
    const cleaned = cleanUrl(raw);
    if (!cleaned || unique.includes(cleaned)) continue;
    unique.push(cleaned);
    if (unique.length >= limit) break;
  }
  return unique;
};

const normalizePhone = (value: string): string => {
  if (!value) return '';
  const unformatted = stripFormatting(value);
  let digits = unformatted.replace(/\D/g, '');
  if (digits.length === 11 && digits.startsWith('1')) digits = digits.slice(1);
  if (digits.length !== 10) return '';
  return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
};

const extractPhones = (md: string, limit = 3): string[] => {
  const withoutUrls = md.replace(/https?:\/\/[^\s)]+/g, ' ');
  const withoutFormatting = stripFormatting(withoutUrls);
  const matches =
    withoutFormatting.match(
      /(?:\+?1[\s().-]*)?(?:\(\d{3}\)|\d{3})[\s().-]*\d{3}[\s().-]*\d{4}|\b1?\d{10}\b/g,
    ) || [];
  const unique: string[] = [];
  for (const candidate of matches) {
    const normalized = normalizePhone(candidate);
    if (!normalized || unique.includes(normalized)) continue;
    unique.push(normalized);
    if (unique.length >= limit) break;
  }
  return unique;
};

const extractBoldTerms = (md: string, limit = 10): string[] => {
  const regex = /\*\*([^*]{2,120})\*\*/g;
  const out: string[] = [];
  let match: RegExpExecArray | null = regex.exec(md);
  while (match) {
    const term = normalizeText(match[1]);
    if (term && !out.includes(term)) out.push(term);
    if (out.length >= limit) break;
    match = regex.exec(md);
  }
  return out;
};

const isLikelyMetadataLine = (line: string): boolean => {
  if (/^#{1,6}\s/.test(line.trim())) return true;
  const normalized = normalizeText(line);
  if (!normalized) return true;
  if (/^(#{1,6}\s*)?(author|by|date|state|references?|disclaimer|table of contents|word count|introduction)\b/i.test(normalized)) return true;
  if (/^(author|date)\s*:/i.test(normalized)) return true;
  if (normalized.includes('|') || /^[:\-|\s]+$/.test(normalized)) return true;
  if (/https?:\/\//i.test(normalized) && normalized.split(' ').length < 3) return true;
  if (/[A-Z]/.test(normalized) && normalized === normalized.toUpperCase() && normalized.length < 90) return true;
  if (/^(provided task input|manus ai)/i.test(normalized)) return true;
  return false;
};

const isQualitySentence = (sentence: string, topicPattern?: RegExp): boolean => {
  const cleaned = normalizeText(sentence.replace(/\[[^\]]+]/g, ''));
  if (!cleaned) return false;
  if (/^(author|by|date|state|references?|disclaimer)\b/i.test(cleaned)) return false;
  if (/(comprehensive guide|word count|manus ai|table of contents|expansion)/i.test(cleaned)) return false;
  if (/:\s*:\s*:/.test(cleaned)) return false;
  if (/\b(key complaint contact|authority program complaint hotline|program complaint hotline)\b/i.test(cleaned)) return false;

  const words = cleaned.split(' ');
  if (words.length < 12 || words.length > 32) return false;

  const hasVerb = /\b(is|are|can|must|requires?|allows?|provides?|depends?|moves?|handles?|supports?|enforces?|routes?|determines?|includes?)\b/i.test(cleaned);
  if (!hasVerb) return false;

  if (topicPattern && !topicPattern.test(cleaned)) return false;

  return true;
};

const pickInsightSentence = (md: string, fallback: string, topicPattern?: RegExp): string => {
  const lines = md
    .split('\n')
    .map((line) => normalizeText(line))
    .filter((line) => line && !isLikelyMetadataLine(line))
    .join(' ');

  const plain = markdownToPlainText(lines);
  if (!plain) return fallback;

  const candidates = plain.match(/[^.!?]+[.!?]/g) || [plain];
  for (const candidate of candidates) {
    if (!isQualitySentence(candidate, topicPattern)) continue;
    const normalized = normalizeText(candidate);
    return normalized.length > 220 ? `${normalized.slice(0, 217).trim()}...` : normalized;
  }
  return fallback;
};

const isWeakAgencyTerm = (term: string): boolean =>
  /^(primary|administering|key|state)\b/i.test(term) ||
  /^(licensing authority|complaint hotline|key authority contact|program|licensing authority website)$/i.test(term) ||
  /(authority website|website)$/i.test(term);

const findAgencyName = (md: string, fallback: string): string => {
  const boldTerms = extractBoldTerms(md, 16)
    .map((term) => sanitizeProgramTerm(term))
    .filter((term) => term && !isWeakAgencyTerm(term));
  const agencyTerm =
    boldTerms.find((term) =>
      /(department|agency|administration|ombudsman|office|division|health|services|medicaid|licensing)/i.test(term),
    ) || '';
  if (agencyTerm) return agencyTerm;

  const heading = md.match(/^#+\s+(.+)$/m)?.[1];
  if (heading) return normalizeText(heading);
  return fallback;
};

const sanitizeProgramTerm = (term: string): string => normalizeText(term.replace(/[:;,\-\u2013\s]+$/g, ''));

const normalizeProgramLabel = (term: string): string => {
  if (!term) return '';
  let normalized = sanitizeProgramTerm(
    term
      .replace(/^(comprehensive guide to|guide to|overview of|understanding)\s+/i, '')
      .replace(/\s*-\s*(comprehensive guide|overview|full guide)$/i, '')
      .replace(/\b(comprehensive guide|full guide|resource guide|handbook|manual)\b/gi, '')
      .replace(/\b([a-z][a-z'’.-]+)\s+to\s+(?=long-term care|ltc|medicaid|home and community)/i, ''),
  );

  // Keep the program side when headings are formatted as "Program: Guide/Overview ..."
  if (normalized.includes(':')) {
    const parts = normalized.split(':');
    const left = sanitizeProgramTerm(parts[0] || '');
    const right = normalizeText(parts.slice(1).join(':'));
    const leftLooksProgram = /(waiver|program|pathways|medi-?cal|medicaid|services|benefit|plan|ltc|long-term care|care)/i.test(left);
    const rightLooksProgram = /(waiver|program|pathways|medi-?cal|medicaid|services|benefit|plan|ltc|long-term care|care)/i.test(right);
    if (leftLooksProgram) {
      normalized = left;
    } else if (!leftLooksProgram && rightLooksProgram) {
      normalized = sanitizeProgramTerm(right);
    }
  }

  normalized = normalized.replace(/^(the|a|an)\s+/i, '');
  normalized = normalized.replace(/^\W+|\W+$/g, '');
  return sanitizeProgramTerm(normalized);
};

const isAgencyLikeLabel = (term: string): boolean =>
  /(department of|health and human services|agency for|commission|administration|division|bureau|office of)\b/i.test(term) &&
  !/(waiver|program|pathways|medicaid|medi-cal|apple health|ltc|long-term care)\b/i.test(term);

const isWeakProgramTerm = (term: string): boolean =>
  /^(primary|program|state|key|author|date)\b/i.test(term) ||
  /(comprehensive guide|introduction|program name|target population|administering agency|state:)/i.test(term) ||
  isAgencyLikeLabel(term);

const extractHeadingTerms = (md: string, limit = 16): string[] => {
  const matches = Array.from(md.matchAll(/^#{1,6}\s+(.+)$/gm));
  const out: string[] = [];
  for (const match of matches) {
    const heading = normalizeProgramLabel(match[1] || '');
    if (!heading || isWeakProgramTerm(heading) || out.includes(heading)) continue;
    out.push(heading);
    if (out.length >= limit) break;
  }
  return out;
};

const findProgramTerms = (md: string, limit = 2): string[] => {
  const candidates = [...extractHeadingTerms(md, 16), ...extractBoldTerms(md, 20)];
  const programs = candidates
    .map((term) => normalizeProgramLabel(term))
    .filter((term) => term && !isWeakProgramTerm(term))
    .filter((term) =>
      /(waiver|program|pathways|medi-?cal|medicaid|services|benefit|plan)/i.test(term),
    );
  return [...new Set(programs)].slice(0, limit);
};

const SECTIONS = [
  { key: 'licensing_content' as const, label: 'Licensing & Oversight', slug: 'licensing', kicker: 'State Authority' },
  { key: 'medicaid_content' as const, label: 'Medicaid & Long-Term Care Programs', slug: 'medicaid', kicker: 'Public Benefits' },
  { key: 'ombudsman_content' as const, label: 'Ombudsman & Resident Advocacy', slug: 'ombudsman', kicker: 'Resident Rights' },
  { key: 'complaints_content' as const, label: 'Filing a Complaint', slug: 'complaints', kicker: 'Accountability' },
  { key: 'veterans_content' as const, label: 'Veterans Benefits & Long-Term Care', slug: 'veterans', kicker: 'Veterans Resources' },
];

const activeSections = SECTIONS.filter((s) => payload[s.key]);
const renderedSections = activeSections.map((s) => ({
  ...s,
  html: mdToHtml(payload[s.key] || ''),
}));

const title = `${stateMeta.name} Assisted Living & Nursing Home Regulations | Licensing, Medicaid, Complaints`;
const description = `${stateMeta.name} regulations for assisted living and nursing homes: licensing authority, Medicaid programs, ombudsman contacts, complaint process, and oversight resources in one page.`;
const canonical = `https://silvertechdirectory.com/regulations/${stateMeta.slug}/`;
const playfairHref = 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap';
const heroImageUrl = 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&q=60&w=1280&h=720';
const isDistrictOfColumbia = stateMeta.slug === 'district-of-columbia';
const hasInsightLayer = activeSections.length > 0;
const insightHeadingId = isDistrictOfColumbia ? 'dc-insights-heading' : 'state-insights-heading';
const jumpLinks: Array<{ label: string; slug: string; kind: 'section' | 'anchor' }> = [
  ...(hasInsightLayer ? [{ label: 'Executive Insights', slug: insightHeadingId, kind: 'anchor' as const }] : []),
  ...activeSections.map((s) => ({ label: s.label, slug: s.slug, kind: 'section' as const })),
  { label: 'Official Contacts', slug: 'regulatory-contacts', kind: 'anchor' },
];
const regulatoryAsOf = fs.existsSync(regulationFilePath)
  ? new Date(fs.statSync(regulationFilePath).mtime)
  : new Date();
const regulatoryVersion = `v${regulatoryAsOf.getUTCFullYear()}.${String(regulatoryAsOf.getUTCMonth() + 1).padStart(2, '0')}`;
const regulatorySnapshotId = `snapshot-${regulatoryVersion.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
const citationPermalink = `${canonical}#${regulatorySnapshotId}`;
const asOfLabel = regulatoryAsOf.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const citationText = `SilverTech Directory (${regulatoryAsOf.getUTCFullYear()}). ${stateMeta.name} Senior Care Regulatory Landscape (${regulatoryVersion}; data as of ${asOfLabel}). Retrieved from ${citationPermalink}`;

const toDisplayName = (value: string): string => {
  if (value !== value.toUpperCase()) return value;

  const uppercaseTokens = new Set([
    'AL', 'AK', 'AZ', 'AR', 'CA', 'CO', 'CT', 'DC', 'DE', 'FL', 'GA', 'HI', 'IA', 'ID', 'IL', 'IN', 'KS', 'KY', 'LA',
    'MA', 'MD', 'ME', 'MI', 'MN', 'MO', 'MS', 'MT', 'NC', 'ND', 'NE', 'NH', 'NJ', 'NM', 'NV', 'NY', 'OH', 'OK', 'OR',
    'PA', 'RI', 'SC', 'SD', 'SE', 'SW', 'TN', 'TX', 'UT', 'VA', 'VT', 'WA', 'WI', 'WV', 'WY', 'NE', 'NW', 'SE', 'SW',
    'N', 'S', 'E', 'W', 'PO', 'US', 'VA', 'CMS', 'ER', 'ICU', 'ICF', 'SNF', 'ALF', 'CCRC', 'RN', 'LPN', 'CNA',
    'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'LLC', 'LLP', 'LP', 'LTD', 'INC', 'PLC', 'PC', 'PA', 'IU',
  ]);

  const lowerWords = new Set(['and', 'or', 'of', 'the', 'at', 'in', 'on', 'for', 'to', 'a', 'an']);

  const formatSegment = (segment: string, wordIndex: number): string => {
    if (!/[A-Za-z]/.test(segment)) return segment;

    const ordinalMatch = segment.match(/^(\d+)(ST|ND|RD|TH)$/);
    if (ordinalMatch) {
      return `${ordinalMatch[1]}${ordinalMatch[2].toLowerCase()}`;
    }

    const upperSegment = segment.toUpperCase();
    if (uppercaseTokens.has(upperSegment)) return upperSegment;

    const lowerSegment = segment.toLowerCase();
    if (wordIndex > 0 && lowerWords.has(lowerSegment)) return lowerSegment;
    return `${lowerSegment[0]?.toUpperCase() || ''}${lowerSegment.slice(1)}`;
  };

  return value
    .toLowerCase()
    .split(/\s+/)
    .map((word, wordIndex) =>
      word
        .split(/([\-'/&])/)
        .map((segment, segmentIndex, segments) => {
          if (segment.length === 1 && /[\-'/&]/.test(segment)) return segment;
          if (segments[segmentIndex - 1] === "'" && /^[a-z]{1,2}$/.test(segment)) return segment.toLowerCase();
          return formatSegment(segment, wordIndex);
        })
        .join(''),
    )
    .join(' ');
};

const stateDirectoryHref = `/assisted-living/${stateMeta.slug}/`;
const stateDirectoryCtaLabel = `Browse all assisted living communities in ${stateMeta.name}`;
const regulationsIndexHref = '/regulations/';
const stateCostGuideHref = `/guides/costs/assisted-living/${stateMeta.slug}/`;
const llmAnchorGuideHref = '/guides/what-families-miss-state-regulations/';
const llmAnchorRegulationStates = new Set(['indiana', 'california', 'texas']);
const showLlmAnchorGuide = llmAnchorRegulationStates.has(stateMeta.slug);

const stateDirectoryData = getSeniorLivingState(stateMeta.slug);
const assistedLivingCities = (stateDirectoryData?.cities || [])
  .filter((city) => city.careTypeCounts['assisted-living'] > 0)
  .sort(
    (a, b) =>
      b.careTypeCounts['assisted-living'] - a.careTypeCounts['assisted-living'] ||
      b.facilityCount - a.facilityCount ||
      a.cityName.localeCompare(b.cityName),
  );
const majorCityCount = assistedLivingCities.length >= 8 ? 8 : assistedLivingCities.length;
const majorCityLinks = assistedLivingCities.slice(0, majorCityCount).map((city) => ({
  citySlug: city.citySlug,
  cityName: toDisplayName(city.cityName),
  href: `/assisted-living/${stateMeta.slug}/${city.citySlug}/`,
  assistedCount: city.careTypeCounts['assisted-living'],
}));
const heroCityLinks = majorCityLinks.slice(0, Math.min(majorCityLinks.length, 6));
const midCityLinks = majorCityLinks.slice(0, Math.min(majorCityLinks.length, 8));
const sectionCityLinks = majorCityLinks.slice(0, 1);
const footerCityLinks = majorCityLinks.slice(0, 4);

const makeStateLink = (label: string, position: GraphLinkPosition): GraphLink => ({
  href: stateDirectoryHref,
  label,
  event: 'reg_to_state',
  position,
  city: null,
});
const makeCityLink = (
  city: { cityName: string; href: string },
  position: GraphLinkPosition,
): GraphLink => ({
  href: city.href,
  label: `assisted living in ${city.cityName}`,
  event: 'reg_to_city',
  position,
  city: city.cityName,
});

const sectionContextLinks: Record<string, GraphLink[]> = {
  licensing: [
    makeStateLink(`${stateMeta.name} assisted living directory`, 'section'),
    ...sectionCityLinks.slice(0, 1).map((city) => makeCityLink(city, 'section')),
  ].slice(0, 3),
  medicaid: [
    {
      href: stateCostGuideHref,
      label: `${stateMeta.name} assisted living cost guide`,
      event: 'reg_to_state',
      position: 'section',
      city: null,
    },
    ...sectionCityLinks.slice(0, 1).map((city) => makeCityLink(city, 'section')),
  ].slice(0, 3),
  complaints: [
    makeStateLink(`${stateMeta.name} assisted living directory`, 'section'),
    ...sectionCityLinks.slice(0, 1).map((city) => makeCityLink(city, 'section')),
  ].slice(0, 3),
  ombudsman: [
    makeStateLink(`${stateMeta.name} assisted living directory`, 'section'),
    ...sectionCityLinks.slice(0, 1).map((city) => makeCityLink(city, 'section')),
  ].slice(0, 3),
  veterans: [
    makeStateLink(`${stateMeta.name} assisted living directory`, 'section'),
    ...sectionCityLinks.slice(0, 1).map((city) => makeCityLink(city, 'section')),
  ].slice(0, 3),
};

const resolveContact = (kind: keyof NonNullable<RegulationPayload['contacts_json']>) =>
  payload.contacts_json?.[kind] || {};

const licensingMd = payload.licensing_content || '';
const medicaidMd = payload.medicaid_content || '';
const ombudsmanMd = payload.ombudsman_content || '';
const complaintsMd = payload.complaints_content || '';

const licensingAgency = normalizeText(resolveContact('licensing').name || '') || findAgencyName(licensingMd, `${stateMeta.name} licensing authority`);
const ombudsmanAgency = normalizeText(resolveContact('ombudsman').name || '') || findAgencyName(ombudsmanMd, `${stateMeta.name} long-term care ombudsman`);
const medicaidAgency = normalizeText(resolveContact('medicaid').name || '') || findAgencyName(medicaidMd, `${stateMeta.name} Medicaid office`);

const licensingPhone = normalizePhone(resolveContact('licensing').phone || '') || extractPhones(licensingMd, 1)[0] || '';
const ombudsmanPhone = normalizePhone(resolveContact('ombudsman').phone || '') || extractPhones(ombudsmanMd, 1)[0] || '';
const medicaidPhone = normalizePhone(resolveContact('medicaid').phone || '') || extractPhones(medicaidMd, 1)[0] || '';
const complaintPhone =
  normalizePhone(resolveContact('elderAbuse').phone || '') ||
  extractPhones(complaintsMd, 1)[0] ||
  extractPhones(licensingMd, 1)[0] ||
  '';

const licensingSourceUrl = normalizeText(resolveContact('licensing').website || '') || extractUrls(licensingMd, 1)[0];
const ombudsmanSourceUrl = normalizeText(resolveContact('ombudsman').website || '') || extractUrls(ombudsmanMd, 1)[0];
const medicaidSourceUrl = normalizeText(resolveContact('medicaid').website || '') || extractUrls(medicaidMd, 1)[0];
const complaintSourceUrl =
  normalizeText(resolveContact('elderAbuse').website || '') ||
  extractUrls(complaintsMd, 1)[0] ||
  licensingSourceUrl;

const medicaidPrograms = findProgramTerms(medicaidMd, 2);
const topProgramLabel = medicaidPrograms[0] || `${stateMeta.name} Medicaid long-term care programs`;
const safeProgramLabel = topProgramLabel || `${stateMeta.name} Medicaid long-term care programs`;
const missingPhoneLabel = 'Not listed - see source';

const licensingAndComplaintsText = `${licensingMd}\n${complaintsMd}`;
const hasInspectionSignals = /(inspection|survey|deficien|citation|unannounced|compliance review)/i.test(licensingAndComplaintsText);
const hasRoutingSignals = /(hotline|intake|district office|regional office|complaint line|ombudsman)/i.test(complaintsMd);
const hasWaiverSignals = /(waiver|hcbs|home and community|pathways|mltss|managed care)/i.test(medicaidMd);
const hasEligibilitySignals = /(asset limit|income limit|share of cost|patient liability|look-back|estate recovery|spousal impoverishment)/i.test(medicaidMd);
const hasPublicReportSignals = /(care compare|public|database|inspection report|report card|cal health find)/i.test(licensingAndComplaintsText);
const hasCentralizedIntakeSignals = /(centralized|statewide intake|single intake|complaint and incident intake)/i.test(complaintsMd);
const hasRegionalIntakeSignals = /(district office|regional office|local office|county office)/i.test(complaintsMd);
const hasManagedCareSignals = /(managed care|mltss|smmc|pathways|altcs|apple health)/i.test(medicaidMd);
const hasRoomBoardSignals = /(room and board|patient liability|share of cost)/i.test(medicaidMd);
const hasLookbackSignals = /(look-back|estate recovery|asset limit|spousal impoverishment)/i.test(medicaidMd);

const nonDcInsightItems: InsightItem[] = [
  {
    title: `${stateMeta.name} oversight spans regulation and advocacy lanes`,
    copy: `${licensingAgency} handles licensing and oversight actions, while ${ombudsmanAgency} supports resident advocacy and escalation support.`,
    sources: [
      ...(licensingSourceUrl ? [{ label: 'Licensing authority', url: licensingSourceUrl }] : []),
      ...(ombudsmanSourceUrl ? [{ label: 'Ombudsman program', url: ombudsmanSourceUrl }] : []),
    ],
  },
  {
    title: `Long-term care eligibility is driven by ${safeProgramLabel}`,
    copy: pickInsightSentence(
      medicaidMd,
      `${stateMeta.name} Medicaid eligibility and program structure determine whether families can use home and community-based options or institutional care.`,
      /(medicaid|waiver|program|eligibility|coverage|long-term care|managed care|benefit)/i,
    ),
    sources: [
      ...(medicaidSourceUrl ? [{ label: 'Medicaid program source', url: medicaidSourceUrl }] : []),
      ...extractUrls(medicaidMd, 2)
        .filter((url) => url !== medicaidSourceUrl)
        .map((url, idx) => ({ label: `Program reference ${idx + 1}`, url })),
    ],
  },
  {
    title: 'Complaint outcomes depend on using the correct channel',
    copy: pickInsightSentence(
      complaintsMd,
      `In ${stateMeta.name}, safety and compliance complaints move through state intake channels, while ombudsman teams help with resident-rights navigation and follow-up.`,
      /(complaint|report|investigat|intake|hotline|ombudsman|enforcement)/i,
    ),
    sources: [
      ...(complaintSourceUrl ? [{ label: 'Complaint channel', url: complaintSourceUrl }] : []),
      ...extractUrls(complaintsMd, 2)
        .filter((url) => url !== complaintSourceUrl)
        .map((url, idx) => ({ label: `Complaint reference ${idx + 1}`, url })),
    ],
  },
];

const nonDcQuickFacts: QuickFactItem[] = [
  {
    heading: 'Licensing Authority',
    value: licensingAgency,
    sourceUrl: licensingSourceUrl,
  },
  {
    heading: 'Regulatory Complaint Line',
    value: complaintPhone || missingPhoneLabel,
    sourceUrl: complaintSourceUrl,
  },
  {
    heading: 'Ombudsman Contact',
    value: ombudsmanPhone || missingPhoneLabel,
    sourceUrl: ombudsmanSourceUrl,
  },
  {
    heading: 'Medicaid LTC Contact',
    value: medicaidPhone || missingPhoneLabel,
    sourceUrl: medicaidSourceUrl,
  },
];

const familiesMissCandidates: FamiliesMissItem[] = [
  {
    title: 'Advocacy and enforcement are different lanes',
    copy: `${ombudsmanAgency} can advocate and escalate concerns, but licensing actions are issued through ${licensingAgency} and complaint investigators.`,
  },
  ...(hasRoutingSignals
    ? [{
        title: hasCentralizedIntakeSignals
          ? `${stateMeta.name} uses centralized complaint intake`
          : hasRegionalIntakeSignals
            ? `${stateMeta.name} routes complaints through regional channels`
            : `${stateMeta.name} complaint routing can change timelines`,
        copy: hasCentralizedIntakeSignals
          ? `Centralized intake can create queue effects. Families in ${stateMeta.name} should document submission dates and keep escalation notes when concerns involve immediate care risks.`
          : hasRegionalIntakeSignals
            ? `Regional routing can produce different response speeds by office. Families should confirm which office owns the case and track follow-up milestones in writing.`
            : `Complaint resolution speed depends on intake route. In ${stateMeta.name}, families should use both the formal complaint line and ombudsman escalation when concerns are urgent.`,
      }]
    : []),
  ...(hasWaiverSignals
    ? [{
        title: hasManagedCareSignals
          ? `Managed-care pathways shape access in ${stateMeta.name}`
          : `Waiver pathways have practical limits in ${stateMeta.name}`,
        copy: hasManagedCareSignals
          ? `${safeProgramLabel} and managed-care routing can change which providers and services are immediately available. Confirm plan participation and authorization steps before tours.`
          : `${safeProgramLabel} may cover services without covering every cost component. Families should verify room-and-board treatment, service caps, and program fit before final placement.`,
      }]
    : []),
  ...(hasEligibilitySignals
    ? [{
        title: hasRoomBoardSignals
          ? 'Room-and-board assumptions can derail planning'
          : hasLookbackSignals
            ? 'Asset and look-back rules can change eligibility outcomes'
            : 'Financial rules can block otherwise good care choices',
        copy: hasRoomBoardSignals
          ? `In ${stateMeta.name}, service coverage and room-and-board obligations can diverge. Families should model monthly out-of-pocket exposure before committing to a placement.`
          : hasLookbackSignals
            ? `${stateMeta.name} long-term care eligibility can hinge on transfer history and estate rules. Validate asset assumptions early to avoid late-stage denials.`
            : `${stateMeta.name} long-term care eligibility can hinge on income, assets, and cost-share rules. Families should validate eligibility assumptions early to avoid late-stage care disruptions.`,
      }]
    : []),
  ...(hasInspectionSignals
    ? [{
        title: hasPublicReportSignals
          ? 'Public reports and inspection cycles tell different stories'
          : 'Inspection history and complaint history are separate signals',
        copy: hasPublicReportSignals
          ? `Public dashboards summarize history, but inspection timing and complaint outcomes can move on different clocks. In ${stateMeta.name}, review both before final decisions.`
          : `Inspection cycles show baseline compliance, while complaint outcomes reveal issue response. In ${stateMeta.name}, both records matter before tours and final decisions.`,
      }]
    : []),
  ...(hasPublicReportSignals
    ? [{
        title: 'Public reporting can lag real-time care changes',
        copy: `Public dashboards are useful, but update windows vary. Families in ${stateMeta.name} should pair published records with direct facility questions and documented follow-up.`,
      }]
    : [{
        title: 'Keep escalation contacts ready before a crisis',
        copy: `Store licensing, complaint, and ombudsman contacts before tours so concerns can be escalated quickly with written timelines and follow-up.`,
      }]),
];

const nonDcFamiliesMiss = familiesMissCandidates.slice(0, 4);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://silvertechdirectory.com/' },
    { '@type': 'ListItem', position: 2, name: 'Regulations', item: 'https://silvertechdirectory.com/regulations/' },
    { '@type': 'ListItem', position: 3, name: stateMeta.name, item: canonical },
  ],
};
---
<Base title={title} description={description} canonical={canonical}>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="preload" as="style" href={playfairHref} />
  <link slot="head" href={playfairHref} rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript slot="head">
    <link href={playfairHref} rel="stylesheet" />
  </noscript>
  <link slot="head" rel="preload" as="image" href={heroImageUrl} />
  <link slot="head" rel="stylesheet" href="/styles/senior-living.css" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <div
    class="container sl-page sl-state-page"
    data-reg-supabase-url={import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.VITE_SUPABASE_URL || ''}
    data-reg-supabase-anon-key={import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.VITE_SUPABASE_ANON_KEY || ''}
  >
    <nav class="sl-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/regulations/">Regulations</a>
      <span>/</span>
      <span>{stateMeta.name}</span>
    </nav>

    <section class="sl-state-hero">
      <div class="sl-state-hero-bg">
        <img
          src={heroImageUrl}
          alt={`${stateMeta.name} senior care regulations`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1280"
          height="720"
          sizes="100vw"
        />
      </div>
      <div class="sl-state-hero-overlay"></div>
      <div class="sl-state-hero-copy">
        <div class="sl-state-hero-badge-row">
          <span class="sl-state-hero-flag" aria-hidden="true">{stateMeta.abbreviation}</span>
          <span class="sl-state-hero-kicker">Official State Regulatory Hub</span>
        </div>
        <h1 class="sl-state-hero-title">
          <span>{stateMeta.name} </span>
          <span class="sl-state-hero-accent">Regulations</span>
        </h1>
        <p class="sl-state-hero-lead">
          Looking for {stateMeta.name} assisted living and nursing home regulations? Start here: {licensingAgency} handles licensing and oversight, with state Medicaid, ombudsman, and complaint pathways linked below.
        </p>
        <div class="sl-state-hero-actions">
          <a
            class="sl-btn sl-btn-primary"
            href={stateDirectoryHref}
            data-reg-track="reg_to_state"
            data-reg-position="hero"
            data-reg-state={stateMeta.slug}
            data-reg-city=""
          >
            View {stateMeta.name} Directory
          </a>
          <a class="sl-btn sl-btn-secondary" href="#licensing">Read Oversight Rules</a>
        </div>
      </div>
    </section>

    <section class="sl-state-overview" aria-label={`${stateMeta.name} regulation quick answer`}>
      <div class="sl-state-overview-copy">
        <p>
          <strong>Direct answer:</strong> For families comparing communities in {stateMeta.name}, verify licensing authority first, then check complaint and ombudsman channels, then confirm Medicaid pathway fit before deposit.
        </p>
      </div>
    </section>

    {heroCityLinks.length > 0 && (
      <section class="sl-reg-graph-links" aria-labelledby="sl-hero-cities-heading">
        <div class="sl-reg-graph-intro">
          <h2 id="sl-hero-cities-heading">Cities Covered Under These Regulations</h2>
          <p>Open high-demand city hubs, then move directly into facility pages with verified records.</p>
        </div>
        <div class="sl-reg-graph-city-grid">
          {heroCityLinks.map((city) => (
            <a
              class="sl-reg-graph-city-link"
              href={city.href}
              data-reg-track="reg_to_city"
              data-reg-position="hero"
              data-reg-state={stateMeta.slug}
              data-reg-city={city.cityName}
            >
              <span>assisted living in {city.cityName}</span>
              <small>{city.assistedCount.toLocaleString()} listings</small>
            </a>
          ))}
        </div>
        <a
          class="sl-reg-mid-cta"
          href={stateDirectoryHref}
          data-reg-track="reg_to_state"
          data-reg-position="hero"
          data-reg-state={stateMeta.slug}
          data-reg-city=""
        >
          {stateDirectoryCtaLabel}
        </a>
      </section>
    )}

    {isDistrictOfColumbia && (
      <section class="sl-insight-layer" aria-labelledby="dc-insights-heading">
        <div class="sl-insight-card">
          <div class="sl-insight-head">
            <p class="sl-insight-kicker">Regulatory Analysis Hub</p>
            <h2 id="dc-insights-heading">Executive Insights and Key Takeaways</h2>
            <p class="sl-insight-meta">SilverTech interpretation. As of {asOfLabel} ({regulatoryVersion}).</p>
          </div>
          <ol class="sl-insight-list">
            <li>
              <h3>DC oversight runs through coordinated agencies</h3>
              <p>
                DC Health HRLA handles licensing, inspections, and enforcement, while the Long-Term Care Ombudsman
                focuses on resident advocacy and dispute navigation.
              </p>
              <p class="sl-insight-source">
                Sources:
                <a href="https://dchealth.dc.gov/" target="_blank" rel="noopener noreferrer nofollow">DC Health HRLA</a>,
                <a href="https://www.aarp.org/legal-counsel-for-elderly/what-we-do/info-2017/dc-long-term-care-ombudsman.html" target="_blank" rel="noopener noreferrer nofollow">DC Long-Term Care Ombudsman</a>
              </p>
            </li>
            <li>
              <h3>Complaint channel choice changes the response path</h3>
              <p>
                Families reporting immediate safety or care-standard concerns generally need the state complaint line,
                while quality-of-life concerns often route through ombudsman advocacy.
              </p>
              <p class="sl-insight-source">
                Sources:
                <a href="https://dchealth.dc.gov/page/file-complaint-against-dc-health-facility" target="_blank" rel="noopener noreferrer nofollow">DC Health complaint process</a>,
                <a href="https://www.aarp.org/legal-counsel-for-elderly/what-we-do/info-2017/dc-long-term-care-ombudsman.html" target="_blank" rel="noopener noreferrer nofollow">Ombudsman role</a>
              </p>
            </li>
            <li>
              <h3>Current data indicators suggest a potential multi-year review lag in some cases</h3>
              <p>
                Public reporting can span multiple years of oversight history, so single-year snapshots may miss
                complaint trend changes. Review historical records and complaint pathways together before concluding risk
                patterns.
              </p>
              <p class="sl-insight-source">
                Sources:
                <a href="https://dchealth.dc.gov/service/heath-care-facility-inspection-reports" target="_blank" rel="noopener noreferrer nofollow">DC inspection reports</a>,
                <a href="https://dchealth.dc.gov/page/file-complaint-against-dc-health-facility" target="_blank" rel="noopener noreferrer nofollow">DC complaint process</a>
              </p>
            </li>
          </ol>
        </div>

        <div class="sl-quick-facts" aria-label="District quick facts">
          <p class="sl-quick-facts-label">Quick Facts Snapshot (As of {asOfLabel})</p>
          <div class="sl-quick-facts-grid">
            <article class="sl-quick-fact-card">
              <p class="sl-quick-fact-heading">Licensing Authority</p>
              <p class="sl-quick-fact-value">DC Health (HRLA)</p>
              <a href="https://dchealth.dc.gov/" target="_blank" rel="noopener noreferrer nofollow">Source</a>
            </article>
            <article class="sl-quick-fact-card">
              <p class="sl-quick-fact-heading">Regulatory Complaint Line</p>
              <p class="sl-quick-fact-value">(877) 672-2174</p>
              <a href="https://dchealth.dc.gov/page/file-complaint-against-dc-health-facility" target="_blank" rel="noopener noreferrer nofollow">Source</a>
            </article>
            <article class="sl-quick-fact-card">
              <p class="sl-quick-fact-heading">Ombudsman Contact</p>
              <p class="sl-quick-fact-value">(202) 434-2190</p>
              <a href="https://www.aarp.org/legal-counsel-for-elderly/what-we-do/info-2017/dc-long-term-care-ombudsman.html" target="_blank" rel="noopener noreferrer nofollow">Source</a>
            </article>
            <article class="sl-quick-fact-card">
              <p class="sl-quick-fact-heading">Medicaid LTC Contact</p>
              <p class="sl-quick-fact-value">(202) 442-9533</p>
              <a href="https://dhcf.dc.gov/page/contact-information-0" target="_blank" rel="noopener noreferrer nofollow">Source</a>
            </article>
          </div>
        </div>

        {midCityLinks.length > 0 && (
          <section class="sl-reg-graph-links" aria-labelledby="sl-major-cities-heading">
            <div class="sl-reg-graph-intro">
              <h2 id="sl-major-cities-heading">Major Cities in {stateMeta.name}</h2>
              <p>High-demand city hubs with active assisted living coverage.</p>
            </div>
            <div class="sl-reg-graph-city-grid">
              {midCityLinks.map((city) => (
                <a
                  class="sl-reg-graph-city-link"
                  href={city.href}
                  data-reg-track="reg_to_city"
                  data-reg-position="mid"
                  data-reg-state={stateMeta.slug}
                  data-reg-city={city.cityName}
                >
                  <span>assisted living in {city.cityName}</span>
                  <small>{city.assistedCount.toLocaleString()} listings</small>
                </a>
              ))}
            </div>
            <a
              class="sl-reg-mid-cta"
              href={stateDirectoryHref}
              data-reg-track="reg_to_state"
              data-reg-position="mid"
              data-reg-state={stateMeta.slug}
              data-reg-city=""
            >
              {stateDirectoryCtaLabel}
            </a>
          </section>
        )}

        <div class="sl-families-miss" aria-labelledby="dc-families-miss-heading">
          <h2 id="dc-families-miss-heading">What Families Often Miss</h2>
          <div class="sl-families-miss-grid">
            <article>
              <h3>Advocacy is different from enforcement</h3>
              <p>
                The Ombudsman role is primarily advocate-driven rather than regulatory. It can mediate and escalate,
                but statutory enforcement actions like fines and license outcomes sit with regulatory agencies.
              </p>
            </article>
            <article>
              <h3>Inspection timing does not replace active reporting</h3>
              <p>
                Historical survey patterns show a heavy concentration of oversight activity during standard business
                hours. Weekend staffing and care issues are still actionable, but often depend on direct reporting to
                trigger review.
              </p>
            </article>
            <article>
              <h3>Facility due diligence should use two records</h3>
              <p>
                Review both state licensing and federal certification context before finalizing a care decision.
              </p>
            </article>
            <article>
              <h3>Public contact paths are part of your leverage</h3>
              <p>
                Families who know complaint and advocacy contacts can escalate concerns faster and document follow-up
                more clearly.
              </p>
            </article>
          </div>
        </div>

        <div class="sl-cite-box" id={regulatorySnapshotId}>
          <div>
            <p class="sl-cite-kicker">Cite This Research</p>
            <p class="sl-cite-copy">
              Use this standard citation format for reporting, policy analysis, and research references.
            </p>
            <p class="sl-cite-copy">
              Permalink: <a href={citationPermalink}>{citationPermalink}</a>
            </p>
            <code class="sl-cite-code" id="dc-citation-text">{citationText}</code>
          </div>
          <button type="button" class="sl-cite-button" data-copy-citation={citationText} data-default-label="Copy Full Citation">
            Copy Full Citation
          </button>
        </div>
      </section>
    )}

    {!isDistrictOfColumbia && hasInsightLayer && (
      <section class="sl-insight-layer" aria-labelledby="state-insights-heading">
        <div class="sl-insight-card">
          <div class="sl-insight-head">
            <p class="sl-insight-kicker">Regulatory Analysis Hub</p>
            <h2 id="state-insights-heading">Executive Insights and Key Takeaways</h2>
            <p class="sl-insight-meta">SilverTech interpretation. As of {asOfLabel} ({regulatoryVersion}).</p>
          </div>
          <ol class="sl-insight-list">
            {nonDcInsightItems.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
                {item.sources.length > 0 && (
                  <p class="sl-insight-source">
                    Sources:
                    {item.sources.map((source, index) => (
                      <span>
                        {index > 0 ? ', ' : ' '}
                        <a href={source.url} target="_blank" rel="noopener noreferrer nofollow">{source.label}</a>
                      </span>
                    ))}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </div>

        <div class="sl-quick-facts" aria-label={`${stateMeta.name} quick facts`}>
          <p class="sl-quick-facts-label">Quick Facts Snapshot (As of {asOfLabel})</p>
          <div class="sl-quick-facts-grid">
            {nonDcQuickFacts.map((fact) => (
              <article class="sl-quick-fact-card">
                <p class="sl-quick-fact-heading">{fact.heading}</p>
                <p class="sl-quick-fact-value">{fact.value}</p>
                {fact.sourceUrl ? (
                  <a href={fact.sourceUrl} target="_blank" rel="noopener noreferrer nofollow">Source</a>
                ) : (
                  <span class="sl-quick-fact-source">Source in section</span>
                )}
              </article>
            ))}
          </div>
        </div>

        {midCityLinks.length > 0 && (
          <section class="sl-reg-graph-links" aria-labelledby="sl-major-cities-heading">
            <div class="sl-reg-graph-intro">
              <h2 id="sl-major-cities-heading">Major Cities in {stateMeta.name}</h2>
              <p>High-demand city hubs with active assisted living coverage.</p>
            </div>
            <div class="sl-reg-graph-city-grid">
              {midCityLinks.map((city) => (
                <a
                  class="sl-reg-graph-city-link"
                  href={city.href}
                  data-reg-track="reg_to_city"
                  data-reg-position="mid"
                  data-reg-state={stateMeta.slug}
                  data-reg-city={city.cityName}
                >
                  <span>assisted living in {city.cityName}</span>
                  <small>{city.assistedCount.toLocaleString()} listings</small>
                </a>
              ))}
            </div>
            <a
              class="sl-reg-mid-cta"
              href={stateDirectoryHref}
              data-reg-track="reg_to_state"
              data-reg-position="mid"
              data-reg-state={stateMeta.slug}
              data-reg-city=""
            >
              {stateDirectoryCtaLabel}
            </a>
          </section>
        )}

        <div class="sl-families-miss" aria-labelledby="state-families-miss-heading">
          <h2 id="state-families-miss-heading">What Families Often Miss</h2>
          <div class="sl-families-miss-grid">
            {nonDcFamiliesMiss.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))}
          </div>
        </div>

        {showLlmAnchorGuide && (
          <div class="sl-anchor-brief" aria-label="Regulation-first family decision guide">
            <p class="sl-anchor-brief-kicker">Family Decision Brief</p>
            <h2>What families miss without reviewing state regulations</h2>
            <p>
              Before comparing amenities, use this answer-first guide to align on staffing, inspections, disclosure risks,
              and escalation paths that matter in {stateMeta.name}.
            </p>
            <div class="sl-anchor-brief-links">
              <a href={llmAnchorGuideHref}>Read the regulation-first guide</a>
              <a href="/guides/assisted-living-vs-nursing-home-real-differences/">Compare assisted living vs nursing home</a>
              <a href="/guides/senior-care-definitions-plain-english-regulations/">Use the plain-English glossary</a>
              <a href="/guides/senior-care-costs-explained-what-you-actually-pay/">See real cost ranges</a>
              <a href="/guides/how-families-pay-for-senior-living-financial-options/">Plan payment options</a>
            </div>
          </div>
        )}

        <div class="sl-cite-box" id={regulatorySnapshotId}>
          <div>
            <p class="sl-cite-kicker">Cite This Research</p>
            <p class="sl-cite-copy">
              Use this standard citation format for reporting, policy analysis, and research references.
            </p>
            <p class="sl-cite-copy">
              Permalink: <a href={citationPermalink}>{citationPermalink}</a>
            </p>
            <code class="sl-cite-code" id="state-citation-text">{citationText}</code>
          </div>
          <button type="button" class="sl-cite-button" data-copy-citation={citationText} data-default-label="Copy Full Citation">
            Copy Full Citation
          </button>
        </div>
      </section>
    )}

    <section class="sl-state-stats" aria-label="Regulatory context">
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">Verified</p>
        <p class="sl-state-stat-label">Licensing</p>
        <p class="sl-state-stat-note">Official state records</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">Active</p>
        <p class="sl-state-stat-label">Ombudsman</p>
        <p class="sl-state-stat-note">Resident advocacy</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">Direct</p>
        <p class="sl-state-stat-label">Complaints</p>
        <p class="sl-state-stat-note">State intake channels</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">{activeSections.length}</p>
        <p class="sl-state-stat-label">Topic Areas</p>
        <p class="sl-state-stat-note">Full regulatory coverage</p>
      </article>
    </section>

    <div class="sl-reg-layout">
      {jumpLinks.length > 1 && (
        <nav class="sl-reg-nav" aria-label="Regulation sections">
          <p class="sl-reg-nav-label">Jump to section</p>
          <div class="sl-reg-nav-links">
            {jumpLinks.map((link) => (
              <a
                href={`#${link.slug}`}
                {...(link.kind === 'section' ? { 'data-reg-open': link.slug } : {})}
              >
                {link.label}
              </a>
            ))}
          </div>
        </nav>
      )}

      <div class="sl-reg-main">
        {renderedSections.map((section) => (
          <section class="sl-reg-section" id={section.slug} aria-labelledby={`${section.slug}-heading`} data-reg-section>
            <div class="sl-state-section-head">
              <button
                type="button"
                class="sl-reg-toggle"
                data-reg-toggle
                aria-expanded="false"
                aria-controls={`${section.slug}-content`}
              >
                <p class="sl-state-section-kicker">{section.kicker}</p>
                <h2 id={`${section.slug}-heading`}>{section.label}</h2>
                <span class="sl-reg-toggle-indicator" data-reg-indicator>Show</span>
              </button>
            </div>
            <div
              id={`${section.slug}-content`}
              data-reg-panel
              hidden
            >
              <div class="sl-reg-content prose" set:html={section.html} />
              {sectionContextLinks[section.slug]?.length > 0 && (
                <div class="sl-reg-context-links">
                  <p class="sl-reg-context-label">Related {stateMeta.name} links</p>
                  <div class="sl-reg-context-link-grid">
                    {sectionContextLinks[section.slug].map((link) => (
                      <a
                        href={link.href}
                        data-reg-track={link.event}
                        data-reg-position={link.position}
                        data-reg-state={stateMeta.slug}
                        data-reg-city={link.city || ''}
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </section>
        ))}

        {activeSections.length === 0 && (
          <section class="sl-state-overview" id="regulatory-summary">
            <div class="sl-state-section-head">
              <div>
                <p class="sl-state-section-kicker">Oversight Layer</p>
                <h2>Regulatory Summary</h2>
              </div>
            </div>
            <p>Regulatory content for {stateMeta.name} is being updated. Use official licensing and ombudsman resources in the meantime.</p>
          </section>
        )}

        <section class="sl-state-resources" id="regulatory-contacts">
          <div class="sl-state-resources-copy">
            <p class="sl-state-section-kicker">Official Contacts</p>
            <h2>{stateMeta.name} Regulatory Contacts</h2>
            <p>Direct lines to the state agencies that license, inspect, and oversee senior care facilities in {stateMeta.name}.</p>
          </div>
          <div class="sl-state-resource-grid">
            {payload.contacts_json?.licensing?.name && (
              <div class="sl-state-resource-card">
                <strong>Licensing Authority</strong>
                <span>{payload.contacts_json.licensing.name}</span>
                {payload.contacts_json.licensing.phone && <span>{payload.contacts_json.licensing.phone}</span>}
                {payload.contacts_json.licensing.website && (
                  <a href={payload.contacts_json.licensing.website} target="_blank" rel="noopener noreferrer nofollow">Visit website</a>
                )}
              </div>
            )}
            {payload.contacts_json?.ombudsman?.name && (
              <div class="sl-state-resource-card">
                <strong>Ombudsman Program</strong>
                <span>{payload.contacts_json.ombudsman.name}</span>
                {payload.contacts_json.ombudsman.phone && <span>{payload.contacts_json.ombudsman.phone}</span>}
                {payload.contacts_json.ombudsman.website && (
                  <a href={payload.contacts_json.ombudsman.website} target="_blank" rel="noopener noreferrer nofollow">Visit website</a>
                )}
              </div>
            )}
            {payload.contacts_json?.medicaid?.name && (
              <div class="sl-state-resource-card">
                <strong>Medicaid Office</strong>
                <span>{payload.contacts_json.medicaid.name}</span>
                {payload.contacts_json.medicaid.phone && <span>{payload.contacts_json.medicaid.phone}</span>}
                {payload.contacts_json.medicaid.website && (
                  <a href={payload.contacts_json.medicaid.website} target="_blank" rel="noopener noreferrer nofollow">Visit website</a>
                )}
              </div>
            )}
            <div class="sl-state-resource-card">
              <strong>{stateMeta.name} Care Directory</strong>
              <span>Browse licensed senior care facilities by city and care type.</span>
              <a
                href={stateDirectoryHref}
                data-reg-track="reg_to_state"
                data-reg-position="footer"
                data-reg-state={stateMeta.slug}
                data-reg-city=""
              >
                View assisted living directory
              </a>
            </div>
          </div>
        </section>

        <section class="sl-reg-footer-rail" aria-label={`${stateMeta.name} navigation links`}>
          <a
            href={stateDirectoryHref}
            data-reg-track="reg_to_state"
            data-reg-position="footer"
            data-reg-state={stateMeta.slug}
            data-reg-city=""
          >
            {stateMeta.name} assisted living directory
          </a>
          <a href={regulationsIndexHref}>All state regulations</a>
          {footerCityLinks.map((city) => (
            <a
              href={city.href}
              data-reg-track="reg_to_city"
              data-reg-position="footer"
              data-reg-state={stateMeta.slug}
              data-reg-city={city.cityName}
            >
              assisted living in {city.cityName}
            </a>
          ))}
        </section>
      </div>
    </div>

  </div>
</Base>

