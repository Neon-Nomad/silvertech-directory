---
import Base from '../../layouts/Base.astro';
import { ALL_STATES } from '../../../src/data/states';

const title = 'Senior Living by State | SilverTech Directory';
const description = 'Browse senior living directories by state and compare local market coverage for assisted living, memory care, and nursing homes.';
const canonical = 'https://silvertechdirectory.com/states/';
const playfairHref = 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap';
const heroImageUrl = 'https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&q=60&w=1280&h=720';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://silvertechdirectory.com/' },
    { '@type': 'ListItem', position: 2, name: 'States', item: canonical },
  ],
};
---
<Base title={title} description={description} canonical={canonical}>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="preload" as="style" href={playfairHref} />
  <link slot="head" href={playfairHref} rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript slot="head">
    <link href={playfairHref} rel="stylesheet" />
  </noscript>
  <link slot="head" rel="preload" as="image" href={heroImageUrl} />
  <link slot="head" rel="stylesheet" href="/styles/senior-living.css" />

  <div class="container sl-page sl-state-page">
    <nav class="sl-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span>States</span>
    </nav>

    <section class="sl-state-hero">
      <div class="sl-state-hero-bg">
        <img
          src={heroImageUrl}
          alt="National coverage background"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1280"
          height="720"
          sizes="100vw"
        />
      </div>
      <div class="sl-state-hero-overlay"></div>
      <div class="sl-state-hero-copy">
        <div class="sl-state-hero-badge-row">
          <span class="sl-state-hero-flag" aria-hidden="true">US</span>
          <span class="sl-state-hero-kicker">National Coverage</span>
        </div>
        <h1 class="sl-state-hero-title">
          <span>Senior Living </span>
          <span class="sl-state-hero-accent">by State</span>
        </h1>
        <p class="sl-state-hero-lead">
          Select a state to view specialized directories, local pricing benchmarks, and official regulatory resources. SilverTech tracks thousands of licensed communities across the country.
        </p>
        <div class="sl-state-hero-actions">
          <a class="sl-btn sl-btn-primary" href="#state-index">View All States</a>
          <a class="sl-btn sl-btn-secondary" href="/search">Search Communities</a>
        </div>
      </div>
    </section>

    <section class="sl-state-stats" aria-label="Directory stats">
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">51</p>
        <p class="sl-state-stat-label">Jurisdictions</p>
        <p class="sl-state-stat-note">Full state coverage</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">Verified</p>
        <p class="sl-state-stat-label">Data</p>
        <p class="sl-state-stat-note">Official state sources</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">Direct</p>
        <p class="sl-state-stat-label">Access</p>
        <p class="sl-state-stat-note">No broker middlemen</p>
      </article>
      <article class="sl-state-stat">
        <p class="sl-state-stat-value">100%</p>
        <p class="sl-state-stat-label">Free</p>
        <p class="sl-state-stat-note">No commission model</p>
      </article>
    </section>

    <section class="sl-state-section" id="state-index">
      <div class="sl-state-section-head">
        <div>
          <p class="sl-state-section-kicker">Regional Hubs</p>
          <h2>All States</h2>
        </div>
      </div>

      <div class="sl-state-market-grid">
        {ALL_STATES.map((state) => (
          <a class="sl-state-market-link" href={`/states/${state.slug}/`}>
            <strong>{state.name}</strong>
            <span>State directory hub</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</Base>
