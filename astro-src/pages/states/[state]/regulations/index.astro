---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../../../layouts/Base.astro';
import { ALL_STATES } from '../../../../../src/data/states';

type RegulationPayload = {
  licensing_content?: string;
  complaints_content?: string;
  contacts_json?: {
    licensing?: { name?: string; phone?: string; website?: string };
    ombudsman?: { name?: string; phone?: string; website?: string };
    medicaid?: { name?: string; phone?: string; website?: string };
  };
};

export async function getStaticPaths() {
  return ALL_STATES.map((state) => ({ params: { state: state.slug } }));
}

const { state: stateSlugParam } = Astro.params;
const stateMeta = ALL_STATES.find((state) => state.slug === (stateSlugParam || '').toLowerCase());
if (!stateMeta) {
  throw new Error(`State regulations page not found for slug: ${stateSlugParam || 'unknown'}`);
}

const regulationFileName = `${stateMeta.slug.replace(/-/g, '_')}.json`;
const regulationFilePath = path.resolve(process.cwd(), 'src', 'generated', 'regulations', regulationFileName);

let payload: RegulationPayload = {};
if (fs.existsSync(regulationFilePath)) {
  try {
    payload = JSON.parse(fs.readFileSync(regulationFilePath, 'utf-8')) as RegulationPayload;
  } catch (error) {
    console.error('[state-regulations] Failed to parse file:', regulationFilePath, error);
  }
}

const stripMarkdown = (input: string): string =>
  input
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/\[(.*?)\]\([^)]+\)/g, '$1')
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .replace(/\*(.*?)\*/g, '$1')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/\n{3,}/g, '\n\n')
    .trim();

const licensingPlainText = stripMarkdown(payload.licensing_content || '');
const complaintPlainText = stripMarkdown(payload.complaints_content || '');
const contentParagraphs = (licensingPlainText || complaintPlainText)
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter((paragraph) => paragraph.length > 80)
  .slice(0, 10);

const title = `${stateMeta.name} Senior Care Regulations`;
const description = `Licensing, complaint, and oversight reference page for senior care facilities in ${stateMeta.name}.`;
const canonical = `https://silvertechdirectory.com/states/${stateMeta.slug}/regulations`;

const licensingContact = payload.contacts_json?.licensing || {};
const ombudsmanContact = payload.contacts_json?.ombudsman || {};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
};
---
<Base title={title} description={description} canonical={canonical}>
  <link slot="head" rel="stylesheet" href="/styles/senior-living.css" />

  <div class="container sl-page">
    <nav class="sl-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href={`/states/${stateMeta.slug}`}>{stateMeta.name}</a>
      <span>/</span>
      <span>Regulations</span>
    </nav>

    <section class="sl-hero">
      <p class="sl-eyebrow">State Compliance Hub</p>
      <h1>{stateMeta.name} Senior Care Regulations</h1>
      <p>
        This page summarizes key regulatory context for licensed senior care providers in {stateMeta.name}, including
        licensing oversight and complaint pathways.
      </p>
      <div class="sl-hero-actions">
        <a class="sl-btn sl-btn-primary" href={`/senior-living/${stateMeta.slug}/`}>View {stateMeta.name} Senior Living</a>
        <a class="sl-btn sl-btn-secondary" href={`/states/${stateMeta.slug}`}>Back to State Hub</a>
      </div>
    </section>

    <section class="sl-grid">
      <article class="sl-section">
        <h2>Regulatory Summary</h2>
        {contentParagraphs.length > 0 ? (
          contentParagraphs.map((paragraph) => <p>{paragraph}</p>)
        ) : (
          <p>
            Regulatory summary content is being refreshed for {stateMeta.name}. Use the links below to access licensing
            and ombudsman channels directly.
          </p>
        )}
      </article>
      <aside class="sl-section">
        <h2>Official Contacts</h2>
        <ul class="sl-pill-list">
          <li>
            <strong>Licensing Authority</strong>
            <div class="sl-muted">{licensingContact.name || 'State licensing office'}</div>
            {licensingContact.phone ? <div class="sl-muted">{licensingContact.phone}</div> : null}
            {licensingContact.website ? (
              <a href={licensingContact.website} target="_blank" rel="noopener noreferrer nofollow">Visit licensing website</a>
            ) : null}
          </li>
          <li>
            <strong>Long-Term Care Ombudsman</strong>
            <div class="sl-muted">{ombudsmanContact.name || 'State ombudsman program'}</div>
            {ombudsmanContact.phone ? <div class="sl-muted">{ombudsmanContact.phone}</div> : null}
            {ombudsmanContact.website ? (
              <a href={ombudsmanContact.website} target="_blank" rel="noopener noreferrer nofollow">Visit ombudsman website</a>
            ) : null}
          </li>
        </ul>
      </aside>
    </section>
  </div>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
</Base>
