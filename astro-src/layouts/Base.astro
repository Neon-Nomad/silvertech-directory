---
const {
  title = 'SilverTech Directory',
  description = 'Find trusted memory care and assisted living communities with transparent, commission-free listings.',
  keywords,
  canonical = 'https://silvertechdirectory.com/',
  ogImage = 'https://silvertechdirectory.com/hero.png',
  ogType = 'website',
  twitterSite,
  liteHead = false,
  loadFonts = true,
  robots,
  publishedTime,
  modifiedTime
} = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SilverTech Directory',
  url: 'https://silvertechdirectory.com',
  logo: {
    '@type': 'ImageObject',
    url: 'https://silvertechdirectory.com/logo-nav.png',
    width: 500,
    height: 106,
  },
  description: 'Commission-free senior living directory with verified licensed facility listings, state regulations, and transparent cost information for families navigating dementia care and assisted living.',
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  knowsAbout: ['assisted living', 'memory care', 'senior living', 'nursing homes', 'dementia care', 'elder care'],
  sameAs: [
    'https://twitter.com/SilverTechCare',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SilverTech Directory',
  url: 'https://silvertechdirectory.com',
  description: 'Commission-free senior living directory for families comparing assisted living and memory care communities.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://silvertechdirectory.com/search?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {!liteHead && (
      <>
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="SilverTech Directory" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        {twitterSite && <meta name="twitter:site" content={twitterSite} />}
      </>
    )}
    {loadFonts && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
      </>
    )}
    <link rel="stylesheet" href="/styles/astro-base.css" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <slot name="head" />
  </head>
  <body>
    <slot name="pre-body" />
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href="/" aria-label="SilverTech home">
          <img src="/logo-nav.png" alt="SilverTech" width="500" height="106" loading="eager" decoding="async" />
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/">Find Care</a>
          <a href="/pricing/">Pricing</a>
          <a href="/resources/">Resources</a>
          <a href="/why-this-exists/">Why This Exists</a>
          <a href="/for-facilities/" class="cta">For Facilities</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div>(c) {new Date().getFullYear()} SilverTech Directory. All rights reserved.</div>
        <div class="footer-links">
          <a href="/editorial-policy/">Editorial Policy</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
      </div>
    </footer>
  </body>
</html>
